msgstr "Regular price"

#: includes/campaigns.php:2711 includes/campaigns.php:2761
msgid "Oferta actual"
msgstr "Current offer"

#: includes/campaigns.php:2711 includes/campaigns.php:2761
msgid "Precio campaña"
msgstr "Campaign price"

