#. Plugin Name of the plugin
#: taxocommerce-campaigns.php includes/admin.php:7 includes/admin.php:9
#: includes/admin.php:86 includes/social-publication.php:860
msgid "TaxoCommerce Campaigns"
msgstr "TaxoCommerce Marketing Campaigns"

#. Description of the plugin
#: taxocommerce-campaigns.php
msgid ""
"Offer campaigns, campaign pricing, public banners, social offer publishing, "
"and a standalone commercial calendar."
msgstr "Offer campaigns, promotional pricing, public banners, social offer publishing and a standalone marketing calendar."

#. Author of the plugin
#: taxocommerce-campaigns.php
msgid "David Perez"
msgstr "David Perez"

#: includes/admin.php:7
msgid "Campaigns"
msgstr "Marketing campaigns"

#: includes/admin.php:51
msgid "Configuración guardada."
msgstr "Settings saved."

#: includes/admin.php:55
msgid "Banners públicos"
msgstr "Public banners"

#: includes/admin.php:60
msgid "Publicación de ofertas en redes"
msgstr "Publishing offers on social media"

#: includes/admin.php:61
msgid ""
"Estas plantillas pertenecen a Campañas. TaxoCommerce Social aporta las "
"conexiones y los publicadores, pero su calendario editorial permanece "
"separado."
msgstr "These templates belong to Marketing Campaigns. TaxoCommerce Social provides connections and publishers, but its editorial calendar remains separate."

#: includes/admin.php:72
msgid ""
"Variables: {producto}, {campana}, {precio_regular}, {precio_oferta}, "
"{descuento_pct}, {fecha_inicio}, {fecha_fin}, {url}, {categorias}, {imagen}."
msgstr "Variables: {producto}, {campana}, {precio_regular}, {precio_oferta}, {descuento_pct}, {fecha_inicio}, {fecha_fin}, {url}, {categorias}, {imagen}."

#: includes/admin.php:86
msgid ""
"Campañas de ofertas, precios promocionales, banners y agenda comercial "
"autónoma."
msgstr "Promotional campaigns, special prices, banners and a standalone marketing calendar."

#: includes/admin.php:99
msgid ""
"TaxoCommerce Social no está activo. El calendario comercial funciona "
"igualmente; la programación de ofertas en redes se habilitará cuando Social "
"esté disponible."
msgstr "TaxoCommerce Social is not active. The marketing calendar still works; scheduling social offers will become available once Social is active."

#: includes/autotest.php:30
msgid "Autotest de TaxoCommerce Campaigns"
msgstr "TaxoCommerce Campaigns self-test"

#: includes/autotest.php:31
msgid ""
"Comprobaciones de disponibilidad y esquema en modo lectura. No ejecutan "
"campañas, no modifican precios, no crean tablas ni solicitan servicios "
"externos."
msgstr "Read-only availability and schema checks. They do not run campaigns, change prices, create tables or contact external services."

#: includes/autotest.php:40
msgid "Grupo"
msgstr "Group"

#: includes/autotest.php:40
msgid "Comprobación"
msgstr "Check"

#: includes/autotest.php:40
msgid "Estado"
msgstr "Status"

#: includes/autotest.php:40
msgid "Detalle"
msgstr "Details"

#: includes/calendar.php:82
msgid "Calendario de campañas y ofertas"
msgstr "Campaign and promotion calendar"

#: includes/calendar.php:82
msgid ""
"Agenda propia de Campañas. Muestra periodos comerciales y publicaciones de "
"oferta; no mezcla entradas, páginas ni Noticias."
msgstr "Campaigns' own calendar. Shows promotion periods and offer posts; it does not mix in posts, pages or news."

#: includes/campaigns.php:2485
msgid "Importar / Exportar campanas"
msgstr "Import / Export campaigns"

#: includes/campaigns.php:2486
msgid ""
"Intercambia la campana completa: calendario, productos, precio de campana y "
"posicion. Los archivos antiguos que solo contienen calendario siguen siendo "
"compatibles."
msgstr "Exchange complete campaigns, including schedules, products, campaign prices and order. Legacy calendar-only files remain compatible."

#: includes/campaigns.php:2493
msgid "Sustituir completamente los productos de las campanas incluidas"
msgstr "Replace all products in the included campaigns"

#: includes/campaigns.php:2495
msgid "Importar / actualizar"
msgstr "Import / update"

#: includes/campaigns.php:2600
msgid "No hay campañas en este grupo."
msgstr "There are no campaigns in this group."

#: includes/campaigns.php:2659
msgid "Campañas"
msgstr "Marketing campaigns"

#: includes/campaigns.php:2659
msgid ""
"Organiza campanas realizadas, activas y futuras, sus productos y precios "
"promocionales."
msgstr "Manage completed, active and upcoming campaigns, products and promotional prices."

#: includes/campaigns.php:2702
msgid "No hay productos anadidos todavia."
msgstr "No products added yet."

#: includes/campaigns.php:2711 includes/campaigns.php:2761
