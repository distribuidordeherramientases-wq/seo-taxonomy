msgid "Guarda primero la campaña. Despues aparecera aqui el selector multiple de productos y el precio de oferta de cada uno."
msgstr "Kampagne zuerst speichern. Danach erscheinen die Mehrfachauswahl der Produkte und die jeweiligen Aktionspreise."

msgid "Guardar cambios"
msgstr "Änderungen speichern"

msgid "Guardar productos y precios"
msgstr "Produkte und Preise speichern"

msgid "Guardar publicación de ofertas"
msgstr "Angebotsveröffentlichung speichern"

msgid "Hora de publicación comercial"
msgstr "Uhrzeit für kommerzielle Veröffentlichungen"

msgid "Identificador"
msgstr "Kennung"

