msgstr "Regulärer Preis"

#: includes/campaigns.php:2711 includes/campaigns.php:2761
msgid "Oferta actual"
msgstr "Aktuelles Angebot"

#: includes/campaigns.php:2711 includes/campaigns.php:2761
