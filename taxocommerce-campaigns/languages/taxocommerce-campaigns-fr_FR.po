msgstr "Annuler"

msgid "Comprobaciones de disponibilidad y esquema en modo lectura. No ejecutan campañas, no modifican precios, no crean tablas ni solicitan servicios externos."
msgstr "Contrôles en lecture seule de la disponibilité et du schéma. Ils ne lancent aucune campagne, ne modifient pas les prix, ne créent pas de tables et n’utilisent pas de services externes."

msgid "Comprobación"
msgstr "Vérification"

msgid "Conecta al menos una red social para programar productos de campaña."
msgstr "Connectez au moins un réseau social pour programmer les produits de la campagne."

msgid "Configuración guardada."
msgstr "Paramètres enregistrés."

msgid "Conserva el nombre/serie y crea otro ID. No copia productos ni precios."
msgstr "Conserve le nom et la série, mais crée un nouvel identifiant. Ne copie ni les produits ni les prix."

msgid "Crear campaña"
msgstr "Créer une campagne"

msgid "Crear nueva edicion (+1 ano)"
msgstr "Créer une nouvelle édition (+1 an)"

