msgid "Offer campaigns, campaign pricing, banners, social offer publication, and standalone commercial calendar."
msgstr "Campagnes promotionnelles, prix spéciaux, bannières, publication sociale et calendrier marketing autonome."

msgid "Offer campaigns, campaign pricing, public banners, social offer publishing, and a standalone commercial calendar."
msgstr "Campagnes promotionnelles, prix spéciaux, bannières publiques, publications sociales et calendrier marketing autonome."

msgid "Offer campaigns, prices, banners, social offers, and commercial calendar."
msgstr "Campagnes promotionnelles, prix, bannières, offres sociales et calendrier marketing."

msgid "Organiza campanas realizadas, activas y futuras, sus productos y precios promocionales."
msgstr "Gérez les campagnes terminées, en cours et à venir, leurs produits et prix promotionnels."

msgid "Organiza campañas comerciales, ofertas, creatividades y calendario."
msgstr "Organisez les campagnes marketing, les offres, les créations et le calendrier."

msgid "Precio campaña"
msgstr "Prix de campagne"

msgid "Precio habitual"
msgstr "Prix habituel"

msgid "Primero define la campaña y sus fechas. Después podrás añadir los productos."
msgstr "Définissez d’abord la campagne et ses dates. Vous pourrez ensuite ajouter les produits."

msgid "Producto"
msgstr "Produit"

msgid "Producto estrella"
msgstr "Produit vedette"

msgid "Productos"
msgstr "Produits"

msgid "Productos de la campaña"
msgstr "Produits de la campagne"

msgid "Próxima"
msgstr "À venir"

msgid "Próximas"
msgstr "À venir"

msgid "Publicación de ofertas en redes"
msgstr "Publication des offres sur les réseaux sociaux"

msgid "Puedes insertar una campaña con <code>[taxocommerce_campaign]</code>, seleccionar otra con <code>[taxocommerce_campaign key=\"mi-campana\"]</code> o usar <code>[oferta]</code>. El shortcode usa la campaña activa y sus productos; no crea códigos dinámicos como <code>[oferta01]</code>."
msgstr "Insérez une campagne avec <code>[taxocommerce_campaign]</code>, sélectionnez-en une avec <code>[taxocommerce_campaign key=\"mi-campana\"]</code> ou utilisez <code>[oferta]</code>. Le code court utilise la campagne active et ses produits ; il ne crée pas de codes dynamiques comme <code>[oferta01]</code>."

msgid "Quitar"
msgstr "Retirer"

