msgstr "Autocheck"

msgid "Base"
msgstr "Base imponible"

msgid "Base country:"
msgstr "País de origen:"

msgid "CSV and JSON are internal fiscal registers, not official AEAT files. Each export has a 20,000-row upper bound."
msgstr "Los CSV y JSON son libros internos, no archivos oficiales de la AEAT. Máximo 20.000 registros por exportación."

msgid "Cannot read orders."
msgstr "No se pueden consultar los pedidos."

msgid "Changing this date does not erase previously imported records."
msgstr "Cambiar esta fecha no borra los registros importados."

