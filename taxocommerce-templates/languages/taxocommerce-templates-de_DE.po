msgid ""
"Standalone WordPress/WooCommerce request-template routing, SEO role "
"assignments and migration audit."
msgstr "Eigenständiges Routing von WordPress-/WooCommerce-Anfragevorlagen, Zuordnung von SEO-Rollen und Migrationsprüfung."

#. Author of the plugin
#: taxocommerce-templates.php
msgid "David Perez"
msgstr "David Perez"

#: includes/class-tct-association-audit.php:425
