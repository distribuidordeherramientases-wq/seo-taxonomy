" firewall o antibot se clasifican como aviso no concluyente; un error HTTP "
"real sin firma de protección continúa siendo KO."
msgstr ""

#: includes/system-check/seo-core-validation.php:7765
msgid "Enlaces y errores 404"
msgstr "Liens et erreurs 404"

#: includes/system-check/seo-core-validation.php:7766
