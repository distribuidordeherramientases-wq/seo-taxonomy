#: includes/system-check/seo-core-validation.php:7547
msgid "Servicios y conexiones"
msgstr "Diensten en verbindingen"

#: includes/system-check/seo-core-validation.php:7548
msgid ""
"Cada fila representa el estado agregado de un servicio o conexión. Su "
"puntuación forma parte del cálculo global de Plugin Validation."
msgstr "Elke rij toont de samengevoegde status van een dienst of verbinding. De score telt mee voor de algemene Plugin Validation-score."

#: includes/system-check/seo-core-validation.php:7556
msgid "Aceptación post-release"
msgstr "Acceptatie na release"

#: includes/system-check/seo-core-validation.php:7580
msgid "Todavía no hay resultados para este bloque."
msgstr "Er zijn nog geen resultaten voor dit onderdeel."

#: includes/system-check/seo-core-validation.php:7587
