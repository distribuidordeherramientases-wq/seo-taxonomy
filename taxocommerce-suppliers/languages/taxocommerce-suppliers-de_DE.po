msgid "All suppliers"
msgstr "Alle Lieferanten"

msgid "Alta como borrador oculto; vínculo existente; colisión de SKU; categoría por defecto; márgenes y stock."
msgstr "Versteckter Entwurf, vorhandene Verknüpfung, SKU-Konflikt, Standardkategorie, Margen und Bestand."

