msgid "<code>tcsup_settings</code>"
msgstr "tcsup_settings"

msgid "<code>wp-content/uploads/taxocommerce-suppliers/originals/</code>"
msgstr "wp-content/uploads/taxocommerce-suppliers/originals/"

msgid "<code>{$wpdb->prefix}seo_proveedores_productos</code> (nombre lógico; prefijo real del sitio calculado por <code>TCSUP_Schema::catalog_table()</code>). Conserva <code>proveedor</code>, <code>proveedor_id_externo</code>, <code>sku</code>, <code>source_row_key</code>, <code>pais_origen</code>, nombre, marca, categoría de origen, precios, impuestos, moneda, stock, imágenes, <code>object_id</code>, hashes, estados y fechas de importación/sincronización."
msgstr "<code>{$wpdb->prefix}seo_proveedores_productos</code> is the logical table name (the actual site prefix comes from <code>TCSUP_Schema::catalog_table()</code>). It stores supplier, external ID, SKU, source row key, origin country, name, brand, source category, prices, taxes, currency, stock, images, object ID, hashes, selection/sync states and timestamps."

msgid "<code>{$wpdb->prefix}seo_supplier_images</code> contiene <code>supplier</code>, <code>supplier_product_id</code>, <code>supplier_sku</code>, <code>catalog_row_id</code>, <code>product_id</code>, <code>image_url</code>, <code>image_hash</code>, posición, imagen principal, estado y marcas de tiempo. La clave única es <code>(supplier, supplier_sku, image_hash)</code>. Guardar referencias externas desactiva las anteriores y activa/inserta las vigentes; cambiar a Local/Inherit desactiva referencias activas."
msgstr "<code>{$wpdb->prefix}seo_supplier_images</code> stores <code>supplier</code>, <code>supplier_product_id</code>, <code>supplier_sku</code>, <code>catalog_row_id</code>, <code>product_id</code>, <code>image_url</code>, <code>image_hash</code>, position, primary-image flag, status and timestamps. Its unique key is <code>(supplier, supplier_sku, image_hash)</code>. Saving external references replaces active references; switching to Local/Inherit disables them."

msgid "<strong>Aceptar</strong> puede escribir un producto WooCommerce y metadatos; las otras decisiones modifican el estado de selección."
msgstr "Acceptance may update a WooCommerce product and metadata; other decisions change selection status."

msgid "<strong>Alcance:</strong> plugin autónomo <code>taxocommerce-suppliers/</code>, con WordPress 6.5+, PHP 7.4+ y dependencia declarada de WooCommerce. TaxoCommerce Core es opcional para el menú y registro familiar. No confundir este código con el plugin SEO monolítico ni trasladar mejoras al legado."
msgstr "<strong>Scope:</strong> the standalone plugin <code>taxocommerce-suppliers/</code> requires WordPress 6.5+, PHP 7.4+ and WooCommerce. TaxoCommerce Core is optional for menu grouping and family registration. Do not confuse it with the legacy monolithic SEO plugin or apply changes to that legacy code."

msgid "<strong>Autotest</strong> se ejecuta con su propio botón y nonce; inspecciona disponibilidad en modo de solo lectura y muestra Correcto / Aviso / Error. No comprueba el contenido semántico de cada CSV ni garantiza que un servidor externo sirva una imagen."
msgstr "<strong>Autotest</strong> runs from its own button with nonce verification; it performs read-only availability checks and reports Passed / Warning / Error. It does not verify the semantic quality of each CSV or guarantee that an external server will provide an image."

msgid "<strong>Flujo:</strong> CSV local → análisis/mapeo temporal → fila de <code>seo_proveedores_productos</code> → decisión humana → vinculación o borrador WooCommerce → metadatos de origen e imágenes externas → consulta comercial de pedidos. No existe extracción web, crawler, ejecutor externo o pedido automático dentro de Suppliers."
msgstr "<strong>Flow:</strong> local CSV → temporary analysis and mapping → row in <code>seo_proveedores_productos</code> → human decision → WooCommerce product link or draft → source and external image metadata → purchasing lookup. Suppliers does not scrape websites, run crawlers, execute external jobs or place automatic orders."

