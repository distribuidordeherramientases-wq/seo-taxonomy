msgstr "<code>tcsup_save_template</code>, <code>tcsup_delete_template</code>, <code>tcsup_download_template</code>"

msgid "<code>tcsup_settings</code>"
msgstr "<code>tcsup_settings</code>"

msgid "<code>wp-content/uploads/taxocommerce-suppliers/originals/</code>"
msgstr "<code>wp-content/uploads/taxocommerce-suppliers/originals/</code>"

msgid "<code>{$wpdb->prefix}seo_proveedores_productos</code> (nombre lógico; prefijo real del sitio calculado por <code>TCSUP_Schema::catalog_table()</code>). Conserva <code>proveedor</code>, <code>proveedor_id_externo</code>, <code>sku</code>, <code>source_row_key</code>, <code>pais_origen</code>, nombre, marca, categoría de origen, precios, impuestos, moneda, stock, imágenes, <code>object_id</code>, hashes, estados y fechas de importación/sincronización."
msgstr "<code>${wpdb->prefix}seo_proveedores_productos</code> (logische naam; het daadwerkelijke sitevoorvoegsel wordt berekend door <code>TCSUP_Schema::catalog_table()</code>). Bevat <code>proveedor</code>, <code>proveedor_id_externo</code>, <code>sku</code>, <code>source_row_key</code>, <code>pais_origen</code>, naam, merk, broncategorie, prijzen, belastingen, valuta, voorraad, afbeeldingen, <code>object_id</code>, hashes, statussen en import-/synchronisatiedatums."

msgid "<code>{$wpdb->prefix}seo_supplier_images</code> contiene <code>supplier</code>, <code>supplier_product_id</code>, <code>supplier_sku</code>, <code>catalog_row_id</code>, <code>product_id</code>, <code>image_url</code>, <code>image_hash</code>, posición, imagen principal, estado y marcas de tiempo. La clave única es <code>(supplier, supplier_sku, image_hash)</code>. Guardar referencias externas desactiva las anteriores y activa/inserta las vigentes; cambiar a Local/Inherit desactiva referencias activas."
msgstr "<code>${wpdb->prefix}seo_supplier_images</code> bevat <code>supplier</code>, <code>supplier_product_id</code>, <code>supplier_sku</code>, <code>catalog_row_id</code>, <code>product_id</code>, <code>image_url</code>, <code>image_hash</code>, positie, hoofdafbeelding, status en tijdstempels. De unieke sleutel is <code>(supplier, supplier_sku, image_hash)</code>. Het opslaan van externe verwijzingen deactiveert de vorige en activeert of voegt de huidige toe; overschakelen naar Local/Inherit deactiveert actieve verwijzingen."

msgid "<strong>Aceptar</strong> puede escribir un producto WooCommerce y metadatos; las otras decisiones modifican el estado de selección."
msgstr "<strong>Accepteren</strong> kan een WooCommerce-product en metagegevens wijzigen; andere beslissingen veranderen de selectiestatus."

msgid "<strong>Alcance:</strong> plugin autónomo <code>taxocommerce-suppliers/</code>, con WordPress 6.5+, PHP 7.4+ y dependencia declarada de WooCommerce. TaxoCommerce Core es opcional para el menú y registro familiar. No confundir este código con el plugin SEO monolítico ni trasladar mejoras al legado."
msgstr "<strong>Reikwijdte:</strong> zelfstandige plugin <code>taxocommerce-suppliers/</code>, voor WordPress 6.5+, PHP 7.4+ en met WooCommerce als opgegeven afhankelijkheid. TaxoCommerce Core is optioneel voor het gezamenlijke menu en de registratie. Verwar deze code niet met de monolithische SEO-plugin en breng geen verbeteringen over naar de verouderde code."

msgid "<strong>Autotest</strong> se ejecuta con su propio botón y nonce; inspecciona disponibilidad en modo de solo lectura y muestra Correcto / Aviso / Error. No comprueba el contenido semántico de cada CSV ni garantiza que un servidor externo sirva una imagen."
msgstr "<strong>Zelftest</strong> wordt uitgevoerd met een eigen knop en nonce; controleert alleen-lezen of onderdelen beschikbaar zijn en toont Geslaagd / Waarschuwing / Fout. De test controleert niet de betekenis van iedere CSV en garandeert niet dat een externe server een afbeelding aanbiedt."

msgid "<strong>Flujo:</strong> CSV local → análisis/mapeo temporal → fila de <code>seo_proveedores_productos</code> → decisión humana → vinculación o borrador WooCommerce → metadatos de origen e imágenes externas → consulta comercial de pedidos. No existe extracción web, crawler, ejecutor externo o pedido automático dentro de Suppliers."
msgstr "<strong>Verloop:</strong> lokale CSV → tijdelijke analyse/toewijzing → rij in <code>seo_proveedores_productos</code> → menselijke beslissing → WooCommerce-koppeling of concept → bronmetadata en externe afbeeldingen → commerciële opvraging van bestellingen. Suppliers voert geen webextractie, crawler, externe verwerking of automatische bestellingen uit."

msgid "Abre <strong>TaxoCommerce Core → Suppliers</strong> si Core está activo, o el menú independiente <strong>TaxoCommerce Suppliers</strong>. Su dirección administrativa es <code>admin.php?page=taxocommerce-suppliers</code>. Se requiere una cuenta autorizada para gestionar WooCommerce o las opciones del sitio."
msgstr "Open <strong>TaxoCommerce Core → Suppliers</strong> als Core actief is, of het zelfstandige menu <strong>TaxoCommerce Suppliers</strong>. Het beheeradres is <code>admin.php?page=taxocommerce-suppliers</code>. Een account met rechten om WooCommerce of de websiteopties te beheren is vereist."

msgid "Active WooCommerce sales matched against accepted supplier sources. This is the purchasing/procurement layer; shipping weight and delivery cost remain in TaxoCommerce Logistics."
msgstr "Actieve WooCommerce-verkopen, gekoppeld aan geaccepteerde leveranciersbronnen. Dit is de inkoopfunctie; verzendgewicht en bezorgkosten blijven onderdeel van TaxoCommerce Logistics."

msgid "Al finalizar, el aviso distingue filas procesadas, nuevas, actualizadas, sin cambios y con error. El resultado se examina en <strong>Inventory</strong> (o en <strong>Prices</strong> para la plantilla de actualización de costes). Revisa las referencias sin país, sin SKU o con conflictos antes de aceptarlas."
msgstr "Na afronding onderscheidt de melding verwerkte, nieuwe, bijgewerkte, ongewijzigde en mislukte rijen. Bekijk het resultaat onder <strong>Inventory</strong> (of <strong>Prices</strong> bij een sjabloon voor kostenupdates). Controleer referenties zonder land of SKU en referenties met conflicten voordat u ze accepteert."

msgid "Alta como borrador oculto; vínculo existente; colisión de SKU; categoría por defecto; márgenes y stock."
msgstr "Een verborgen concept aanmaken; bestaande koppeling; SKU-conflict; standaardcategorie; marges en voorraad."

msgid "Antes de editar, inspeccionar clases relacionadas y compatibilidad de tablas compartidas. Cada cambio debe disponer de Issue, PR vinculado, pruebas y nota en <code>CHANGELOG.md</code>. Ajustar <code>readme.txt</code> y versión del archivo principal antes de publicar en WordPress.org, conservar el <code>changelog.txt</code> histórico y excluir los scripts <code>tests/</code> del ZIP. La validación debe hacerse en STAGING; <strong>PRODUCCIÓN requiere autorización expresa</strong>."
msgstr "Controleer vóór wijzigingen de betrokken klassen en de compatibiliteit van gedeelde tabellen. Elke wijziging vereist een Issue, gekoppelde PR, tests en een vermelding in <code>CHANGELOG.md</code>. Werk <code>readme.txt</code> en de versie van het hoofdbestand bij vóór publicatie op WordPress.org, behoud het historische <code>changelog.txt</code> en sluit scripts in <code>tests/</code> uit van het ZIP-bestand. Valideer in STAGING; <strong>PRODUCTIE vereist uitdrukkelijke toestemming</strong>."

msgid "Bootstrap, versión, alta en Core y API pública."
msgstr "Opstarten, versie, registratie in Core en openbare API."

msgid "CSV originales subidos; no están en la carpeta instalable del plugin y no se deben confundir con tests."
msgstr "Geüploade oorspronkelijke CSV-bestanden staan buiten de installatiemap van de plugin en zijn geen tests."

msgid "Cabecera válida e inválida; separadores; plantilla personalizada; reimportación; modo precio sin altas nuevas."
msgstr "Geldige en ongeldige kopregels; scheidingstekens; aangepast sjabloon; herimport; prijsmodus zonder nieuwe producten."

msgid "Cabeceras oficiales, segmento p_ de URL, país, dominio e identidad."
msgstr "Officiële kopregels, p_-URL-segment, land, domein en identiteit."

msgid "Componentes, hooks, opciones, tablas y columnas indicadas por el control."
msgstr "Controleer de componenten, hooks, opties, tabellen en kolommen in het rapport."

msgid "Comprueba el nombre del archivo, el separador detectado y la vista previa de hasta ocho filas. El CSV debe disponer de cabecera y tener un tamaño admitido por WordPress."
msgstr "Controleer de bestandsnaam, het gevonden scheidingsteken en de voorbeeldweergave van maximaal acht rijen. De CSV moet kopregels bevatten en binnen de uploadlimiet van WordPress vallen."

msgid "Conservar locks de aceptación, compatibilidad SKU/país y metadatos."
msgstr "Behoud acceptatievergrendelingen, SKU-/landcompatibiliteit en metagegevens."

msgid "Consulta pedidos y presenta enlaces externos; no compra automáticamente ni modifica estados de pedidos."
msgstr "Leest bestellingen en toont externe links; koopt niet automatisch en wijzigt geen bestelstatussen."

msgid "Descargar cabecera canónica, crear plantillas desde un archivo JSON/CSV/TXT o texto pegado, descargar, consultar y eliminar plantillas personalizadas."
msgstr "Download de canonieke kopregel, maak sjablonen vanuit JSON/CSV/TXT of geplakte tekst en bekijk, download of verwijder aangepaste sjablonen."

msgid "Devuelve una fila a <code>pendiente</code> desde la acción masiva."
msgstr "Zet een rij via de bulkactie terug naar <code>pendiente</code>."

msgid "Durante el análisis CSV, asigna los campos, abre <strong>Save this mapping as a reusable template</strong> y escribe un nombre. Se conservan los nombres de las columnas de origen, no su posición fija: si un proveedor reordena columnas sin cambiar sus nombres, la plantilla puede reutilizarse."
msgstr "Wijs tijdens de CSV-analyse de velden toe, open <strong>Save this mapping as a reusable template</strong> en voer een naam in. De namen van de bronkolommen worden bewaard, niet hun vaste positie. Als een leverancier kolommen herschikt zonder hun namen te wijzigen, kan het sjabloon opnieuw worden gebruikt."

msgid "Ejemplo JSON: <code>{\"mapping\":{\"proveedor_id_externo\":\"Supplier ID\",\"nombre\":\"Product Name\",\"precio_con_iva\":\"Price\"}}</code>. Para CSV/TXT utiliza dos columnas separadas por coma o punto y coma. Guarda la plantilla, selecciónala posteriormente en <strong>CSV Import</strong> y revisa la asignación antes de importar. Puedes descargar el JSON de respaldo junto al nombre de cualquier plantilla personalizada."
msgstr "JSON-voorbeeld: <code>{\"mapping\":{\"proveedor_id_externo\":\"Supplier ID\",\"nombre\":\"Product Name\",\"precio_con_iva\":\"Price\"}}</code>. Gebruik voor CSV/TXT twee kolommen gescheiden door een komma of puntkomma. Sla het sjabloon op, selecteer het later onder <strong>CSV Import</strong> en controleer de toewijzing vóór de import. U kunt de JSON-back-up bij ieder aangepast sjabloon downloaden."

msgid "El archivo principal registra <code>taxocommerce_suppliers_activate()</code> para crear/actualizar tablas y establecer márgenes iniciales. En <code>plugins_loaded</code> (prioridad 30), <code>taxocommerce_suppliers_boot()</code> llama a <code>TCSUP_Schema::maybe_install()</code> y <code>TCSUP_Admin::boot()</code>. Las pestañas Manual y Autotest se cargan desde sus clases propias. El registro en Core se realiza con <code>taxocommerce_core_register_modules</code> y el filtro de catálogo familiar."
msgstr "Het hoofdbestand registreert <code>taxocommerce_suppliers_activate()</code> voor het aanmaken of bijwerken van tabellen en het instellen van beginmarges. Bij <code>plugins_loaded</code> (prioriteit 30) roept <code>taxocommerce_suppliers_boot()</code> <code>TCSUP_Schema::maybe_install()</code> en <code>TCSUP_Admin::boot()</code> aan. De tabbladen Manual en Autotest worden via hun eigen klassen geladen. Registratie in Core verloopt via <code>taxocommerce_core_register_modules</code> en het filter van de pluginfamilie."

msgid "El código actual lee el CSV local con <code>SplFileObject</code>. No añadir llamadas de red, colas automáticas o nuevos scrapers como parte de una corrección documental. La aceptación en WooCommerce se realiza por una acción distinta de importar. El registro de resultados de la pantalla muestra contadores, no constituye un historial permanente por fila."
msgstr "De huidige code leest de lokale CSV met <code>SplFileObject</code>. Voeg bij een documentatiecorrectie geen netwerkverzoeken, automatische wachtrijen of nieuwe scrapers toe. Het accepteren in WooCommerce gebeurt via een andere actie dan importeren. De resultaatweergave bevat tellers en is geen permanent historisch overzicht per rij."

msgid "El módulo guarda URLs y metadatos de imágenes del proveedor en una tabla propia; <strong>no descarga los archivos ni crea adjuntos en la Biblioteca de Medios</strong>. Elegir Local o Inherit desactiva las referencias externas activas de esa fila, pero no genera automáticamente nuevas imágenes locales. Comprueba los derechos de uso y la disponibilidad de las URLs en el sitio de origen."
msgstr "De module bewaart URL's en metadata van leveranciersafbeeldingen in een eigen tabel; <strong>downloadt geen bestanden en maakt geen bijlagen in de mediabibliotheek aan</strong>. Local of Inherit kiezen deactiveert de actieve externe verwijzingen van die rij, maar maakt niet automatisch nieuwe lokale afbeeldingen aan. Controleer gebruiksrechten en beschikbaarheid van de URL's bij de bron."

msgid "El módulo intenta localizar una vinculación previa por ID de objeto, metadatos de catálogo/proveedor o SKU compatible. Puede actualizar precios calculados con los márgenes configurados, existencia, marca, referencias externas y metadatos del proveedor. Confirma que el vínculo es correcto antes de aceptar; las referencias VEVOR por mercado no deben tratarse como un único producto."
msgstr "De module probeert eerdere koppelingen te vinden via object-ID, catalogus-/leveranciersmetadata of een compatibele SKU. Ze kan met de ingestelde marges berekende prijzen, voorraad, merk, externe verwijzingen en leveranciersmetadata bijwerken. Controleer de koppeling vóór acceptatie; VEVOR-referenties van verschillende markten mogen niet als één product worden behandeld."

msgid "Eliminar una plantilla personalizada borra su definición, no las filas ya importadas."
msgstr "Een aangepast sjabloon verwijderen wist de definitie, niet de eerder geïmporteerde rijen."

msgid "En <strong>CSV Import</strong>, selecciona una plantilla y escribe el nombre del proveedor. Las plantillas pueden proponer uno."
msgstr "Selecteer onder <strong>CSV Import</strong> een sjabloon en voer de leveranciersnaam in. Een sjabloon kan een naam voorstellen."

msgid "En <strong>CSV Templates</strong>, despliega <strong>Crear nueva plantilla de proveedor</strong>. Escribe un nombre y, opcionalmente, el proveedor. Sube una definición JSON, CSV o TXT (máximo 64 KiB) o pega su contenido. Las definiciones usan pares de <code>campo interno</code> y <code>columna de origen</code>; al menos <code>proveedor_id_externo</code> y <code>nombre</code> deben estar presentes."
msgstr "Vouw onder <strong>CSV Templates</strong> <strong>Crear nueva plantilla de proveedor</strong> uit. Voer een naam en eventueel een leverancier in. Upload een JSON-, CSV- of TXT-definitie (maximaal 64 KiB) of plak de inhoud. Definities bestaan uit paren <code>campo interno</code> en <code>columna de origen</code>; minimaal <code>proveedor_id_externo</code> en <code>nombre</code> zijn vereist."

msgid "En <strong>External Images</strong>, filtra la lista y pulsa <strong>Edit</strong> sobre una referencia. Elige <strong>External references</strong>, <strong>Local Media</strong> o <strong>Inherit existing behavior</strong>. Si utilizas referencias externas, pega una URL por línea y pulsa <strong>Save external images</strong>."
msgstr "Filter onder <strong>External Images</strong> de lijst en klik bij een referentie op <strong>Edit</strong>. Kies <strong>External references</strong>, <strong>Local Media</strong> of <strong>Inherit existing behavior</strong>. Als u externe verwijzingen gebruikt, plak dan één URL per regel en klik op <strong>Save external images</strong>."

msgid "En <strong>Inventory</strong>, filtra por proveedor, decisión, país y texto (nombre, SKU o ID externo). La lista muestra 50 filas por página con precio, stock, estado de selección, estado de sincronización y, si existe, enlace al producto WooCommerce."
msgstr "Filter onder <strong>Inventory</strong> op leverancier, beslissing, land en tekst (naam, SKU of externe ID). De lijst toont 50 rijen per pagina met prijs, voorraad, selectiestatus, synchronisatiestatus en eventueel een link naar het WooCommerce-product."

msgid "En <strong>Prices</strong>, guarda los porcentajes <strong>Default sale margin</strong> y <strong>Default regular margin</strong>. Los valores de instalación son 20 % y 45 %, respectivamente. Al aceptar un producto con coste numérico se calcula el precio mediante <em>coste base × (1 + margen/100)</em>; el módulo toma preferentemente <code>precio_con_iva</code> y, si no está, <code>precio_sin_iva</code>. Comprueba siempre que ese origen y el tratamiento fiscal sean los adecuados."
msgstr "Sla onder <strong>Prices</strong> de percentages <strong>Default sale margin</strong> en <strong>Default regular margin</strong> op. De standaardwaarden zijn respectievelijk 20% en 45%. Bij acceptatie van een product met numerieke kosten wordt de prijs berekend als <em>basiskosten × (1 + marge/100)</em>; de module gebruikt bij voorkeur <code>precio_con_iva</code> en anders <code>precio_sin_iva</code>. Controleer altijd of de bron en de belastingbehandeling correct zijn."

msgid "En <strong>Review normalization</strong>, asigna las columnas de origen a los campos de TaxoCommerce. Para una importación normal son obligatorios el identificador externo y el nombre del producto. La plantilla VEVOR utiliza su propia normalización."
msgstr "Wijs onder <strong>Review normalization</strong> de bronkolommen toe aan TaxoCommerce-velden. Een normale import vereist een externe ID en productnaam. VEVOR heeft eigen normalisatie."

msgid "En modo <code>canonical</code> se esperan las cabeceras de los campos internos; <code>mapping</code> usa nombres del fichero; <code>vevor</code> transforma las seis cabeceras oficiales, extrae el ID numérico de 12 dígitos de <code>p_</code> e infiere el país desde el dominio cuando el CSV no lo indica. <code>price_update</code> solo actualiza fuentes identificadas de manera inequívoca y no crea filas."
msgstr "In de modus <code>canonical</code> worden de kopregels van interne velden verwacht; <code>mapping</code> gebruikt de kolomnamen uit het bestand; <code>vevor</code> zet zes officiële kopregels om, haalt de numerieke 12-cijferige ID uit <code>p_</code> en leidt het land af uit het domein als de CSV dit niet vermeldt. <code>price_update</code> werkt alleen ondubbelzinnig geïdentificeerde bronnen bij en maakt geen rijen aan."

msgid "Estado de aceptación, <code>object_id</code> y producto/variación del pedido."
msgstr "Acceptatiestatus, <code>object_id</code> en product/variatie van de bestelling."

msgid "Evitar migraciones destructivas y preservar tablas compartidas/legadas."
msgstr "Vermijd destructieve migraties en behoud gedeelde en verouderde tabellen."

msgid "Extensión .csv, límite de subida, permisos de almacenamiento, cabecera y delimitador."
msgstr "Extensie .csv, uploadlimiet, opslagrechten, kopregel en scheidingsteken."

msgid "Filtrar filas, aceptar, revisar, descartar o devolver a pendiente."
msgstr "Rijen filteren, accepteren, ter controle markeren, afwijzen of terugzetten naar in afwachting."

msgid "Guarda el CSV original e inserta o actualiza filas del catálogo intermedio; no publica productos."
msgstr "Slaat de oorspronkelijke CSV op en voegt rijen toe aan of werkt rijen bij in de tussencatalogus; publiceert geen producten."

msgid "Guarda referencias y su estado; no descarga archivos a Media."
msgstr "Slaat verwijzingen en hun status op; downloadt geen bestanden naar de mediabibliotheek."

msgid "Guardar actualiza los datos del proveedor; solo aplica precios WooCommerce cuando se marca <em>Apply Woo prices</em>."
msgstr "Opslaan werkt leveranciersgegevens bij; WooCommerce-prijzen worden alleen toegepast als <em>Apply Woo prices</em> is aangevinkt."

msgid "Guardar evidencia y revisar despliegue antes de ejecutar migraciones."
msgstr "Bewaar bewijs en controleer de uitrol voordat u migraties uitvoert."

msgid "Han pasado dos horas o el archivo original ya no es legible."
msgstr "Er zijn twee uur verstreken of het oorspronkelijke bestand kan niet meer worden gelezen."

msgid "Haz una copia de seguridad de las tablas de proveedores y de la base de datos antes de una importación importante. Importar un CSV <strong>no publica productos de inmediato</strong>, pero aceptar una fila sí puede crear un producto o modificar otro ya vinculado. Trabaja primero con pocas referencias y comprueba país, proveedor, SKU, precios e IVA. El módulo no realiza scraping ni descarga catálogos de sitios web."
msgstr "Maak vóór een belangrijke import een back-up van de leverancierstabellen en de database. Het importeren van een CSV <strong>publiceert producten niet direct</strong>, maar een rij accepteren kan een product aanmaken of een bestaand gekoppeld product wijzigen. Begin met enkele referenties en controleer land, leverancier, SKU, prijzen en btw. De module voert geen scraping uit en downloadt geen catalogi van websites."

msgid "La acción <strong>Delete</strong> solo aparece para las personalizadas. No elimina productos, filas del inventario ni archivos CSV ya almacenados. Después de cambiar un formato de proveedor, verifica el mapeo antes de importar de nuevo."
msgstr "De actie <strong>Delete</strong> verschijnt alleen voor aangepaste sjablonen. Ze verwijdert geen producten, voorraadr ijen of eerder opgeslagen CSV-bestanden. Controleer na een wijziging van het leveranciersformaat de toewijzing voordat u opnieuw importeert."

msgid "La clave única definida en esquema es <code>(proveedor, pais_origen, proveedor_id_externo, source_row_key)</code>. Para datos VEVOR con país, la importación busca esa identidad compuesta y aplica una reconciliación limitada para filas heredadas sin <code>source_row_key</code>. Para otros proveedores también verifica identificador externo y SKU, y marca conflictos si conducen a filas distintas. <strong>No eliminar país o clave de variante</strong> para simplificar consultas: se producirían colisiones entre mercados."
msgstr "De unieke sleutel in het schema is <code>(proveedor, pais_origen, proveedor_id_externo, source_row_key)</code>. Voor VEVOR-gegevens met land zoekt de import naar deze samengestelde identiteit en voert beperkte afstemming uit voor oude rijen zonder <code>source_row_key</code>. Bij andere leveranciers controleert de module ook externe ID en SKU en markeert conflicten als die naar verschillende rijen verwijzen. <strong>Verwijder het land of de variatiesleutel niet</strong> om opvragingen te vereenvoudigen: dat veroorzaakt botsingen tussen markten."

msgid "La consulta actual usa <code>limit = -1</code> para pedidos activos, por lo que en tiendas de gran volumen conviene evaluar su coste antes de ampliar el panel. No substituir la API WooCommerce por consultas directas a <code>wp_posts</code>: debe mantenerse la compatibilidad HPOS."
msgstr "De huidige opvraging gebruikt <code>limit = -1</code> voor actieve bestellingen. Beoordeel daarom bij grote winkels de belasting voordat u het paneel uitbreidt. Vervang de WooCommerce-API niet door directe opvragingen van <code>wp_posts</code>: HPOS-compatibiliteit moet behouden blijven."

msgid "La importación se ejecuta al confirmar el formulario: no se ofrece aquí una cola de scraping o importación XLS/XLSX. Una sesión de análisis caduca a las dos horas; si aparece <em>session expired</em>, vuelve a subir el fichero. No cierres ni repitas la operación sobre un catálogo grande sin comprobar antes su resultado."
msgstr "De import wordt uitgevoerd wanneer het formulier wordt bevestigd: er is hier geen scrapingwachtrij of XLS/XLSX-import. Een analysesessie verloopt na twee uur; verschijnt <em>session expired</em>, upload het bestand dan opnieuw. Sluit of herhaal de bewerking bij een grote catalogus niet zonder eerst het resultaat te controleren."

msgid "La lista de 40 filas por página permite modificar <strong>Excl. tax</strong>, <strong>Incl. tax</strong>, <strong>Tax %</strong> y <strong>Currency</strong>. Pulsar <strong>Save</strong> actualiza los datos de proveedor y sus metadatos asociados cuando existe un producto vinculado; no requiere volver a importar el CSV."
msgstr "Met de lijst van 40 rijen per pagina kunt u <strong>Excl. tax</strong>, <strong>Incl. tax</strong>, <strong>Tax %</strong> en <strong>Currency</strong> wijzigen. <strong>Save</strong> werkt leveranciersgegevens en de bijbehorende metadata bij als er een product gekoppeld is; de CSV hoeft niet opnieuw te worden geïmporteerd."

msgid "La pantalla usa la capacidad <code>manage_woocommerce</code> si WooCommerce está activo, con acceso alternativo para <code>manage_options</code>. Cada operación que modifica estado debe comprobar capacidad y nonce con <code>check_admin_referer()</code>. Las lecturas de filtros GET se saneán y las salidas de usuario pasan por las funciones de escape de WordPress."
msgstr "Het scherm gebruikt de bevoegdheid <code>manage_woocommerce</code> als WooCommerce actief is, met een alternatief voor <code>manage_options</code>. Elke bewerking die de status verandert moet bevoegdheid en nonce controleren met <code>check_admin_referer()</code>. GET-filterwaarden worden opgeschoond en gebruikersgegevens worden veilig weergegeven met de escape-functies van WordPress."

msgid "La pestaña <strong>CSV Templates</strong> muestra únicamente las plantillas guardadas en esta instalación de WordPress; permite crearlas desde un archivo JSON/CSV/TXT o texto pegado, consultarlas, descargarlas y eliminarlas. <strong>CSV Import</strong> ofrece los formatos genéricos CSV canónico y actualización de precios. No se suministran plantillas de proveedores precargadas."
msgstr "Het tabblad <strong>CSV Templates</strong> toont alleen sjablonen die in deze WordPress-installatie zijn opgeslagen; u kunt ze maken op basis van JSON/CSV/TXT of geplakte tekst, bekijken, downloaden en verwijderen. <strong>CSV Import</strong> biedt de algemene indelingen canonieke CSV en prijsupdates. Er worden geen leverancierssjablonen vooraf geïnstalleerd."

msgid "La pestaña <strong>Purchasing</strong> consulta por defecto pedidos WooCommerce <strong>pending</strong>, <strong>on-hold</strong> y <strong>processing</strong>. Muestra número de pedido, línea, cantidad, proveedor, ID/SKU, coste y, cuando existe, enlace <strong>Purchase</strong>. También presenta los casos <em>Without source</em> para que se revise su vinculación."
msgstr "Het tabblad <strong>Purchasing</strong> haalt standaard WooCommerce-bestellingen met de statussen <strong>pending</strong>, <strong>on-hold</strong> en <strong>processing</strong> op. Het toont bestelnummer, bestelregel, aantal, leverancier, ID/SKU, kosten en indien beschikbaar de link <strong>Purchase</strong>. Ook gevallen <em>Without source</em> worden weergegeven zodat de koppeling kan worden gecontroleerd."

msgid "La relación WooCommerce usa, entre otros, los metadatos <code>_seo_proveedor</code>, <code>_seo_proveedor_id_externo</code>, <code>_seo_proveedor_catalogo_id</code>, <code>_seo_proveedor_pais</code>, <code>_seo_proveedor_sku</code> y <code>_seo_imagenes_externas</code>. Una migración de esquema o identidades debe considerar los consumidores externos de estas claves."
msgstr "De WooCommerce-koppeling gebruikt onder andere de metavelden <code>_seo_proveedor</code>, <code>_seo_proveedor_id_externo</code>, <code>_seo_proveedor_catalogo_id</code>, <code>_seo_proveedor_pais</code>, <code>_seo_proveedor_sku</code> en <code>_seo_imagenes_externas</code>. Bij migratie van schema of identiteit moet rekening worden gehouden met externe gebruikers van deze sleutels."

msgid "La valoración de peso, portes y coste de entrega se realiza en <strong>TaxoCommerce Logistics</strong>. Suppliers ofrece la relación comercial con el proveedor, pero no sustituye la gestión del pedido en WooCommerce."
msgstr "De berekening van gewicht, verzendkosten en leveringskosten gebeurt in <strong>TaxoCommerce Logistics</strong>. Suppliers biedt de commerciële relatie met de leverancier, maar vervangt het orderbeheer in WooCommerce niet."

msgid "Los campos <strong>Woo regular</strong> y <strong>Woo sale</strong> están habilitados únicamente para productos vinculados. Marca explícitamente <strong>Apply Woo prices</strong> para modificar los precios del producto WooCommerce. Si no lo marcas, solo se actualizan los datos de coste/metadatos del proveedor. Revisa moneda, impuestos y descuentos antes de guardar."
msgstr "De velden <strong>Woo regular</strong> en <strong>Woo sale</strong> zijn alleen beschikbaar voor gekoppelde producten. Vink <strong>Apply Woo prices</strong> expliciet aan om WooCommerce-productprijzen te wijzigen. Zonder dit vinkje worden alleen de leverancierskosten en metadata bijgewerkt. Controleer valuta, belastingen en kortingen voordat u opslaat."

msgid "Los márgenes definidos en opciones se aplican sobre el precio base, priorizando <code>precio_con_iva</code>, y se redondean con la precisión de WooCommerce. Stock numérico activa gestión de existencias y cantidad; sin cantidad se determina disponibilidad según el estado textual admitido. Estos comportamientos <strong>son efectos de aceptar</strong> y deben cubrirse por pruebas de regresión antes de cualquier cambio."
msgstr "De ingestelde marges worden toegepast op de basisprijs, bij voorkeur <code>precio_con_iva</code>, en afgerond met de WooCommerce-precisie. Een numerieke voorraad activeert voorraadbeheer en aantallen; zonder aantal wordt de beschikbaarheid bepaald via de ondersteunde tekststatus. Deze gedragingen <strong>zijn gevolgen van acceptatie</strong> en moeten vóór wijzigingen met regressietests worden afgedekt."

msgid "Los scripts tests se excluyen del ZIP distribuible."
msgstr "Testscripts worden uitgesloten van het distributie-ZIP-bestand."

msgid "Marca la fila <code>descartado</code> y sincronización ignorada."
msgstr "Markeert de rij als <code>descartado</code> en negeert de synchronisatie."

msgid "Marca la fila <code>revisar</code>."
msgstr "Markeert de rij als <code>revisar</code>."

msgid "Marca las filas deseadas de la página actual, elige <strong>Accept / link to WooCommerce</strong>, <strong>Mark for review</strong>, <strong>Discard</strong> o <strong>Return to pending</strong> y pulsa <strong>Apply</strong>. Consulta los recuentos de procesadas y errores. No interpretes el selector <em>Select all rows on this page</em> como selección de todo el catálogo."
msgstr "Selecteer de gewenste rijen op de huidige pagina, kies <strong>Accept / link to WooCommerce</strong>, <strong>Mark for review</strong>, <strong>Discard</strong> of <strong>Return to pending</strong> en klik op <strong>Apply</strong>. Bekijk de aantallen verwerkte rijen en fouten. Het keuzemenu <em>Select all rows on this page</em> selecteert niet de volledige catalogus."

msgid "Modo de imagen, URLs guardadas, consumidor de imágenes externas y sitio de origen."
msgstr "Afbeeldingsmodus, opgeslagen URL's, afnemer van externe afbeeldingen en bronwebsite."

msgid "Márgenes comerciales (por defecto 20 y 45); valores acotados por el controlador de ajustes."
msgstr "Commerciële marges (standaard 20 en 45); waarden worden begrensd door de instellingencontroller."

msgid "No equivale a borrar un producto WooCommerce ya creado."
msgstr "Dit staat niet gelijk aan het verwijderen van een bestaand WooCommerce-product."

msgid "No introducir lógica de UI/importación dentro del bootstrap."
msgstr "Voeg geen interface- of importlogica toe aan het opstartbestand."

msgid "No resuelve automáticamente un conflicto de identidad."
msgstr "Dit lost een identiteitsconflict niet automatisch op."

msgid "No utilizar métodos de instalación, aceptación, importación ni envío."
msgstr "Gebruik geen installatie-, acceptatie-, import- of verzendmethoden."

msgid "Opcionalmente introduce un nombre para guardar la asignación como plantilla reutilizable y pulsa <strong>Import into intermediate inventory</strong>."
msgstr "Voer desgewenst een naam in om de toewijzing als herbruikbaar sjabloon op te slaan en klik op <strong>Import into intermediate inventory</strong>."

msgid "Para importar un CSV regional de VEVOR, selecciona el proveedor en <strong>CSV Import</strong>. El módulo reconoce las columnas <code>Name</code>, <code>URL to product</code>, <code>categoryPath</code>, <code>URL to image</code>, <code>Currency</code> y <code>Sales</code> y determina el mercado por la URL o la columna Country. No se precarga ninguna plantilla VEVOR. Cada mercado conserva su identidad sin fusionar productos por SKU."
msgstr "Om een regionale VEVOR-CSV te importeren selecteert u de leverancier onder <strong>CSV Import</strong>. De module herkent de kolommen <code>Name</code>, <code>URL to product</code>, <code>categoryPath</code>, <code>URL to image</code>, <code>Currency</code> en <code>Sales</code> en bepaalt de markt via de URL of de kolom Country. Er wordt geen VEVOR-sjabloon vooraf geladen. Elke markt behoudt zijn eigen identiteit; producten worden niet alleen op SKU samengevoegd."

msgid "Pedidos activos sin fuente, con fuente exacta, variación que hereda fuente del padre y enlaces válidos."
msgstr "Actieve bestellingen zonder bron, met exacte bron, variatie die de bron van het hoofdproduct erft en geldige links."

msgid "Permisos y nonces, escape, SQL preparado, PHP lint, smoke, Plugin Check y ZIP sin <code>tests/</code>."
msgstr "Rechten en nonces, uitvoerescapes, voorbereide SQL, PHP-lint, rooktests, Plugin Check en ZIP zonder <code>tests/</code>."

msgid "Precios de fuente/Woo y vínculos de imágenes."
msgstr "Bron-/WooCommerce-prijzen en afbeeldingskoppelingen."

msgid "Presentación y regresión de la interfaz/contratos."
msgstr "Weergave en regressietests van interface en contracten."

msgid "Primero busca una fuente aceptada para el producto de la línea; si es una variación sin fuente, intenta usar la del producto padre. Si hay varias fuentes, presenta alternativas. <strong>Purchase</strong> abre la página del proveedor en otra pestaña: no envía pedidos, no realiza pagos ni reserva stock."
msgstr "Eerst zoekt de module een geaccepteerde bron voor het product op de bestelregel. Bij een variatie zonder bron probeert ze de bron van het hoofdproduct. Bij meerdere bronnen worden alternatieven getoond. <strong>Purchase</strong> opent de leverancierspagina in een nieuw tabblad: er worden geen bestellingen verzonden, betalingen uitgevoerd of voorraden gereserveerd."

msgid "Puede modificar precio, stock y metadatos de un producto existente."
msgstr "Kan de prijs, voorraad en metagegevens van een bestaand product wijzigen."

msgid "Puntos de extensión y precauciones"
msgstr "Uitbreidingspunten en aandachtspunten"

msgid "Referencias externas nuevas, duplicadas, cambio de modo y ausencia de descargas a Media."
msgstr "Nieuwe externe verwijzingen, duplicaten, moduswissels en geen downloads naar de mediabibliotheek."

msgid "Registro familiar: <code>taxocommerce_core_register_modules</code> y <code>taxocommerce_core_family_extensions</code>. Filtro de compras: <code>taxocommerce_suppliers_purchasing_order_statuses</code>. Mantener las firmas de métodos y nombres de acciones para no romper integraciones de la familia."
msgstr "Registratie in de familie: <code>taxocommerce_core_register_modules</code> en <code>taxocommerce_core_family_extensions</code>. Inkoopfilter: <code>taxocommerce_suppliers_purchasing_order_statuses</code>. Behoud methodesignaturen en actienamen om integraties binnen de familie niet te verbreken."

msgid "Repetir Analyze CSV y revisar el mapeo."
msgstr "Voer Analyze CSV opnieuw uit en controleer de toewijzing."

msgid "Resolver identidad/categoría antes de volver a aceptar."
msgstr "Los het identiteit-/categorieprobleem op voordat u het opnieuw accepteert."

msgid "Respetar identidad, prevención de duplicados, VEVOR y formato CSV."
msgstr "Respecteer identiteit, voorkom duplicaten en behoud VEVOR- en CSV-contracten."

msgid "Revisa antes los datos que motivaron su descarte."
msgstr "Controleer eerst de gegevens die tot afwijzing hebben geleid."

msgid "Revisar vínculo de catálogo y producto."
msgstr "Controleer de koppeling tussen catalogus en product."

msgid "Selecciona <strong>Supplier Price Update CSV</strong> cuando solo debas renovar costes de referencias existentes. Exige una identidad (ID externo o SKU) y al menos una columna de precio; para VEVOR exige <strong>ID externo y país</strong>. Este modo <strong>no crea filas nuevas</strong>. Los registros no identificados o ambiguos se contabilizan como error."
msgstr "Kies <strong>Supplier Price Update CSV</strong> als u alleen kosten van bestaande referenties wilt bijwerken. Een identificatie (externe ID of SKU) en minimaal één prijskolom zijn vereist; voor VEVOR zijn <strong>externe ID en land</strong> vereist. Deze modus <strong>maakt geen nieuwe rijen aan</strong>. Niet-identificeerbare of dubbelzinnige gegevens worden als fout geteld."

msgid "Selecciona un archivo <strong>.csv</strong> y pulsa <strong>Analyze CSV</strong>. El módulo admite separadores de punto y coma, coma o tabulador; intenta detectar el apropiado."
msgstr "Selecteer een <strong>.csv</strong>-bestand en klik op <strong>Analyze CSV</strong>. De module ondersteunt puntkomma's, komma's en tabs als scheidingsteken en probeert dit automatisch te herkennen."

msgid "Selección y aceptación de filas; la interfaz del inventario envía las acciones individuales por <code>tcsup_bulk_action</code>."
msgstr "Selectie en acceptatie van rijen; de voorraadinterface verzendt afzonderlijke acties via <code>tcsup_bulk_action</code>."

msgid "Si no hay coincidencia, usa <code>WC_Product_Simple</code> y crea un borrador oculto con la categoría WooCommerce predeterminada. Para fuentes ya enlazadas puede actualizar precio, stock, marca, metadatos y enlaces de imagen. Tras guardar actualiza <code>object_id</code>, <code>hash_aplicado</code>, <code>snapshot_aplicado</code> y estado de sincronización."
msgstr "Als er geen overeenkomst is, gebruikt de module <code>WC_Product_Simple</code> en maakt een verborgen concept aan in de standaardcategorie van WooCommerce. Bij al gekoppelde bronnen kan ze prijs, voorraad, merk, metadata en afbeeldingslinks bijwerken. Na het opslaan worden <code>object_id</code>, <code>hash_aplicado</code>, <code>snapshot_aplicado</code> en de synchronisatiestatus bijgewerkt."

msgid "Si no se encuentra un producto existente y hay categoría WooCommerce predeterminada válida, se crea un <strong>producto simple en borrador, oculto del catálogo</strong>, asociado a esa categoría. No se publica automáticamente ni se asigna directamente a la categoría final del árbol comercial. Debes revisar y completar el producto antes de publicarlo desde WooCommerce."
msgstr "Als er geen bestaand product is gevonden en er een geldige standaardcategorie voor WooCommerce bestaat, wordt een <strong>eenvoudig product als concept aangemaakt, verborgen in de catalogus</strong>, gekoppeld aan die categorie. Het wordt niet automatisch gepubliceerd of direct toegewezen aan de uiteindelijke commerciële categorie. Controleer en voltooi het product in WooCommerce vóór publicatie."

msgid "Si una funcionalidad cambia, actualizar tanto el procedimiento operativo (botones, riesgos, resultados) como el contrato técnico (clases, tablas, hooks y pruebas). No inventar opciones que no existan en el plugin. Conservar esta estructura de dos manuales completos en la pestaña Manual para que el siguiente desarrollador no dependa de conversaciones anteriores."
msgstr "Wanneer een functie verandert, moeten zowel de gebruiksinstructies (knoppen, risico's, resultaten) als het technische contract (klassen, tabellen, hooks en tests) worden bijgewerkt. Verzin geen opties die niet in de plugin bestaan. Behoud beide volledige handleidingen in het tabblad Manual, zodat een volgende ontwikkelaar niet afhankelijk is van eerdere gesprekken."

msgid "Solo diagnóstico; no repara tablas ni procesa pedidos."
msgstr "Alleen diagnose; herstelt geen tabellen en verwerkt geen bestellingen."

msgid "Subida/análisis e inserción/actualización intermedia."
msgstr "Upload/analyse en tussentijds toevoegen/bijwerken."

msgid "Subir, analizar, asignar columnas e importar."
msgstr "Uploaden, analyseren, kolommen toewijzen en importeren."

msgid "Suppliers recibe catálogos CSV facilitados por proveedores, los normaliza y mantiene en un inventario intermedio. Permite revisar cada referencia antes de crear o enlazar productos WooCommerce, corregir los costes, conservar referencias de imágenes externas y consultar qué proveedor corresponde a una venta."
msgstr "Suppliers ontvangt CSV-catalogi van leveranciers, normaliseert deze en bewaart ze in een tussencatalogus. U kunt iedere referentie controleren voordat u WooCommerce-producten aanmaakt of koppelt, kosten corrigeren, externe afbeeldingsverwijzingen bewaren en opzoeken welke leverancier bij een verkoop hoort."

msgid "There are no pending, on-hold, or processing WooCommerce order lines to purchase."
msgstr "Er zijn geen WooCommerce-bestelregels in afwachting, in de wacht of in behandeling om in te kopen."

msgid "Transient de análisis, cabeceras, vista previa y ruta temporal; duración de dos horas."
msgstr "Analysetransient, kopregels, voorbeeldweergave en tijdelijk pad; twee uur geldig."

msgid "Usar APIs de pedidos WooCommerce; no SQL directo sobre tablas de pedidos."
msgstr "Gebruik WooCommerce-bestel-API's; geen directe SQL op besteltabellen."

msgid "Utilizar <code>$wpdb->prepare()</code>, con <code>%i</code> para identificadores cuando proceda, y evitar interpolar entradas no fiables. No asumir que una URL externa es un archivo local. Los CSV originales residen bajo <code>uploads</code> y pueden contener información comercial: antes de ampliar los endpoints, comprobar autorización, accesibilidad pública, tipos de fichero y límites. No introducir exportaciones o rutas de descarga de originales sin petición explícita y evaluación de seguridad."
msgstr "Gebruik <code>$wpdb->prepare()</code>, met <code>%i</code> voor identificatoren waar passend, en vermijd het rechtstreeks invoegen van niet-vertrouwde waarden. Ga er niet van uit dat een externe URL een lokaal bestand is. Oorspronkelijke CSV-bestanden staan onder <code>uploads</code> en kunnen commerciële informatie bevatten. Controleer vóór uitbreiding van endpoints de autorisatie, publieke toegankelijkheid, bestandstypen en limieten. Voeg geen export of downloadroutes voor oorspronkelijke bestanden toe zonder expliciet verzoek en veiligheidsbeoordeling."

msgid "VEVOR US/DE/NL/FR con igual SKU, variante distinta, país ausente, ID y URL erróneos."
msgstr "VEVOR US/DE/NL/FR met dezelfde SKU, andere variant, ontbrekend land, foutieve ID en URL."

msgid "Verificar referencias; Suppliers no importa archivos a Media."
msgstr "Controleer de verwijzingen; Suppliers importeert geen bestanden in de mediabibliotheek."

msgid "Versión %s. Guía de operación y referencia para futuros desarrolladores del <strong>plugin independiente</strong>. Abrir esta pestaña no importa CSV, modifica precios ni ejecuta compras."
msgstr "Versie %s. Gebruiksaanwijzing en referentie voor toekomstige ontwikkelaars van de <strong>zelfstandige plugin</strong>. Dit tabblad openen importeert geen CSV-bestanden, wijzigt geen prijzen en voert geen inkopen uit."

msgid "Versión del esquema, actualmente <code>1.0.0</code>; <code>maybe_install()</code> comprueba tablas y puede ejecutar dbDelta."
msgstr "Schemaversie, momenteel <code>1.0.0</code>; <code>maybe_install()</code> controleert tabellen en kan dbDelta uitvoeren."

msgid "WooCommerce es obligatorio para aceptación de productos y consultas de compras; TaxoCommerce Core es opcional para agrupar el menú. El módulo no gestiona pesos y transportes (Logistics), no ejecuta scraping (Scrappers) y no publica automáticamente productos. No modificar el plugin monolítico ni asumir que sus clases antiguas siguen disponibles."
msgstr "WooCommerce is verplicht voor het accepteren van producten en het opvragen van inkopen; TaxoCommerce Core is optioneel voor het gezamenlijke menu. De module beheert geen gewichten of verzending (Logistics), voert geen scraping uit (Scrappers) en publiceert niet automatisch producten. Wijzig de monolithische plugin niet en ga er niet van uit dat de oude klassen beschikbaar zijn."

msgid "WooCommerce, categoría por defecto, SKU ocupado y mensajes de conflicto."
msgstr "WooCommerce, standaardcategorie, bezette SKU en conflictmeldingen."

