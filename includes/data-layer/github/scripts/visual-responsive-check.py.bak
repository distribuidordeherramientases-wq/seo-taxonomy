#!/usr/bin/env python3
import base64
import json
import os
import re
import sys
import time
from pathlib import Path
from typing import Any, Dict, List

import requests
from playwright.sync_api import sync_playwright, TimeoutError as PlaywrightTimeoutError

CALLBACK_URL = os.environ.get("SEO_VISUAL_CALLBACK_URL", "").strip()
CALLBACK_TOKEN = os.environ.get("SEO_VISUAL_CALLBACK_TOKEN", "").strip()
RUN_ID = os.environ.get("SEO_VISUAL_RUN_ID", "").strip()
URLS_B64 = os.environ.get("SEO_VISUAL_URLS_B64", "").strip()
GITHUB_RUN_URL = os.environ.get("SEO_VISUAL_GITHUB_RUN_URL", "").strip()
ARTIFACT_ROOT = Path("visual-artifacts")

VIEWPORTS = {
    "mobile": {
        "width": 390, "height": 844, "is_mobile": True, "has_touch": True, "scale": 2.75,
        "user_agent": "Mozilla/5.0 (Linux; Android 14; Pixel 8) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Mobile Safari/537.36",
    },
    "tablet": {
        "width": 768, "height": 1024, "is_mobile": True, "has_touch": True, "scale": 2.0,
        "user_agent": "Mozilla/5.0 (Linux; Android 14; Tablet) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
    },
    "desktop": {"width": 1440, "height": 1000, "is_mobile": False, "has_touch": False, "scale": 1.0, "user_agent": None},
}


def callback(status: str, message: str = "", report: Dict[str, Any] | None = None) -> None:
    if not CALLBACK_URL or not CALLBACK_TOKEN:
        return
    payload: Dict[str, Any] = {"run_id": RUN_ID, "status": status, "message": message}
    if report is not None:
        payload["report"] = report
    try:
        requests.post(
            CALLBACK_URL,
            json=payload,
            headers={"Authorization": f"Bearer {CALLBACK_TOKEN}"},
            timeout=25,
        ).raise_for_status()
    except Exception as exc:
        print(f"Callback {status} failed: {exc}", file=sys.stderr)


def slugify(value: str) -> str:
    value = re.sub(r"[^a-zA-Z0-9_-]+", "-", value).strip("-").lower()
    return value or "page"


def load_urls() -> Dict[str, str]:
    raw = base64.b64decode(URLS_B64.encode("ascii")).decode("utf-8")
    decoded = json.loads(raw)
    if not isinstance(decoded, dict):
        raise ValueError("urls_b64 must decode to a JSON object")
    result = {}
    for key, url in decoded.items():
        if isinstance(key, str) and isinstance(url, str) and url.startswith(("http://", "https://")):
            result[key] = url
    if not result:
        raise ValueError("No public URLs supplied")
    return result


JS_AUDIT = r"""
() => {
  const vw = window.innerWidth;
  const vh = window.innerHeight;
  const doc = document.documentElement;
  const meta = document.querySelector('meta[name="viewport"]');
  const metaContent = meta ? (meta.getAttribute('content') || '') : '';
  const viewportOk = !!meta && /width\s*=\s*device-width/i.test(metaContent);

  const visible = (el) => {
    if (!el || el.nodeType !== 1) return false;
    const s = getComputedStyle(el);
    const r = el.getBoundingClientRect();
    if (s.display === 'none' || s.visibility === 'hidden' || Number(s.opacity || 1) < 0.05) return false;
    if (el.closest('[aria-hidden="true"], [hidden], template, noscript')) return false;
    return r.width > 3 && r.height > 3;
  };

  const cssPath = (el) => {
    if (!el) return '';
    let out = el.tagName.toLowerCase();
    if (el.id) return out + '#' + el.id;
    const classes = Array.from(el.classList || []).slice(0, 3);
    if (classes.length) out += '.' + classes.join('.');
    return out.slice(0, 180);
  };

  const horizontalOverflowPx = Math.max(0, doc.scrollWidth - vw, document.body ? document.body.scrollWidth - vw : 0);

  const essentialOffscreen = [];
  const essentialNodes = document.querySelectorAll('h1,.entry-title,.product_title,.woocommerce-product-gallery,.summary.entry-summary,.single_add_to_cart_button,main,#main');
  for (const el of essentialNodes) {
    if (!visible(el)) continue;
    const r = el.getBoundingClientRect();
    if (r.right < -4 || r.left > vw + 4 || r.width > vw * 1.18 || r.left < -24 || r.right > vw + 24) {
      essentialOffscreen.push({selector: cssPath(el), left: Math.round(r.left), right: Math.round(r.right), width: Math.round(r.width)});
    }
  }

  const clipped = [];
  const textSelectors = 'h1,h2,h3,h4,p,button,label,.price,.woocommerce-product-details__short-description';
  for (const el of document.querySelectorAll(textSelectors)) {
    if (!visible(el)) continue;
    const text = (el.innerText || '').trim();
    if (text.length < 3) continue;
    const s = getComputedStyle(el);
    const lineClamp = parseInt(s.webkitLineClamp || '0', 10);
    if (lineClamp > 0 || s.textOverflow === 'ellipsis') continue;
    const clipsX = ['hidden', 'clip'].includes(s.overflowX) && el.scrollWidth > el.clientWidth + 4;
    const clipsY = ['hidden', 'clip'].includes(s.overflowY) && el.scrollHeight > el.clientHeight + 4;
    if (clipsX || clipsY) {
      clipped.push({selector: cssPath(el), text: text.slice(0, 90), dx: el.scrollWidth - el.clientWidth, dy: el.scrollHeight - el.clientHeight});
      if (clipped.length >= 30) break;
    }
  }

  const candidates = [];
  const overlapSelectors = 'h1,.entry-title,.product_title,.woocommerce-product-gallery,.summary.entry-summary,.single_add_to_cart_button';
  for (const el of document.querySelectorAll(overlapSelectors)) {
    if (!visible(el)) continue;
    const r = el.getBoundingClientRect();
    if (r.bottom < 0 || r.top > Math.max(vh * 3, 2200)) continue;
    candidates.push({el, r, selector: cssPath(el)});
  }
  const overlaps = [];
  for (let i = 0; i < candidates.length; i++) {
    for (let j = i + 1; j < candidates.length; j++) {
      const a = candidates[i], b = candidates[j];
      if (a.el.contains(b.el) || b.el.contains(a.el)) continue;
      const left = Math.max(a.r.left, b.r.left);
      const top = Math.max(a.r.top, b.r.top);
      const right = Math.min(a.r.right, b.r.right);
      const bottom = Math.min(a.r.bottom, b.r.bottom);
      const iw = right - left, ih = bottom - top;
      if (iw <= 0 || ih <= 0) continue;
      const intersection = iw * ih;
      const smaller = Math.min(a.r.width * a.r.height, b.r.width * b.r.height);
      if (smaller > 0 && intersection > 500 && intersection / smaller > 0.18) {
        overlaps.push({a: a.selector, b: b.selector, ratio: Math.round((intersection / smaller) * 100)});
        if (overlaps.length >= 20) break;
      }
    }
    if (overlaps.length >= 20) break;
  }

  const brokenImages = [];
  for (const img of document.images) {
    if (!visible(img)) continue;
    if (!img.complete || img.naturalWidth === 0 || img.naturalHeight === 0) {
      brokenImages.push({selector: cssPath(img), src: (img.currentSrc || img.src || '').slice(0, 220)});
      if (brokenImages.length >= 20) break;
    }
  }

  return {
    viewport_meta_ok: viewportOk,
    viewport_meta: metaContent,
    horizontal_overflow_px: Math.round(horizontalOverflowPx),
    essential_offscreen: essentialOffscreen,
    clipped_text: clipped,
    overlaps,
    broken_images: brokenImages,
    document_width: doc.scrollWidth,
    viewport_width: vw,
  };
}
"""


def main() -> int:
    ARTIFACT_ROOT.mkdir(parents=True, exist_ok=True)
    urls = load_urls()
    callback("started", f"Auditando {len(urls)} paginas en {len(VIEWPORTS)} viewports.")

    issues: List[Dict[str, str]] = []
    summary = {
        "navigation_errors": 0,
        "viewport_meta_failures": 0,
        "horizontal_overflow": 0,
        "essential_offscreen": 0,
        "clipped_text": 0,
        "overlaps": 0,
        "broken_images": 0,
        "console_errors": 0,
    }
    viewport_runs = 0
    expected_runs = len(urls) * len(VIEWPORTS)
    detailed_runs = []

    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        try:
            for viewport_name, viewport in VIEWPORTS.items():
                context_args = {
                    "viewport": {"width": viewport["width"], "height": viewport["height"]},
                    "screen": {"width": viewport["width"], "height": viewport["height"]},
                    "is_mobile": viewport["is_mobile"],
                    "has_touch": viewport["has_touch"],
                    "device_scale_factor": viewport["scale"],
                    "locale": "es-ES",
                    "color_scheme": "light",
                }
                if viewport.get("user_agent"):
                    context_args["user_agent"] = viewport["user_agent"]
                context = browser.new_context(**context_args)
                for page_name, url in urls.items():
                    page = context.new_page()
                    console_errors: List[str] = []
                    page_errors: List[str] = []
                    page.on("console", lambda msg, bucket=console_errors: bucket.append(msg.text[:300]) if msg.type == "error" else None)
                    page.on("pageerror", lambda exc, bucket=page_errors: bucket.append(str(exc)[:300]))
                    run_data: Dict[str, Any] = {"page": page_name, "viewport": viewport_name, "url": url}
                    try:
                        page.goto(url, wait_until="domcontentloaded", timeout=35000)
                        try:
                            page.wait_for_load_state("networkidle", timeout=7000)
                        except PlaywrightTimeoutError:
                            pass
                        page.wait_for_timeout(500)
                        # Recorre la pagina para activar imagenes/carga diferida antes de medir.
                        page.evaluate("""async () => {
                            const step = Math.max(500, Math.floor(window.innerHeight * 0.8));
                            const maxSteps = 24;
                            for (let i = 0; i < maxSteps; i++) {
                                const before = window.scrollY;
                                window.scrollBy(0, step);
                                await new Promise(r => setTimeout(r, 80));
                                if (window.scrollY === before || window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4) break;
                            }
                            window.scrollTo(0, 0);
                            await new Promise(r => setTimeout(r, 250));
                        }""")
                        audit = page.evaluate(JS_AUDIT)
                        viewport_runs += 1
                        run_data.update(audit)

                        page_dir = ARTIFACT_ROOT / slugify(page_name)
                        page_dir.mkdir(parents=True, exist_ok=True)
                        try:
                            page.screenshot(
                                path=str(page_dir / f"{viewport_name}.jpg"),
                                type="jpeg",
                                quality=72,
                                full_page=True,
                            )
                        except Exception as screenshot_exc:
                            issues.append({"page": page_name, "viewport": viewport_name, "type": "screenshot_error", "detail": str(screenshot_exc)[:300]})

                        if viewport_name in ("mobile", "tablet") and not audit.get("viewport_meta_ok", False):
                            summary["viewport_meta_failures"] += 1
                            issues.append({"page": page_name, "viewport": viewport_name, "type": "viewport_meta", "detail": f"meta viewport: {audit.get('viewport_meta') or 'ausente'}"})
                        if int(audit.get("horizontal_overflow_px", 0)) > 4:
                            summary["horizontal_overflow"] += 1
                            issues.append({"page": page_name, "viewport": viewport_name, "type": "horizontal_overflow", "detail": f"overflow horizontal {audit.get('horizontal_overflow_px')} px"})
                        offscreen = audit.get("essential_offscreen") or []
                        if offscreen:
                            summary["essential_offscreen"] += len(offscreen)
                            for item in offscreen[:5]:
                                issues.append({"page": page_name, "viewport": viewport_name, "type": "essential_offscreen", "detail": json.dumps(item, ensure_ascii=False)[:300]})
                        clipped = audit.get("clipped_text") or []
                        if clipped:
                            summary["clipped_text"] += len(clipped)
                            for item in clipped[:5]:
                                issues.append({"page": page_name, "viewport": viewport_name, "type": "clipped_text", "detail": json.dumps(item, ensure_ascii=False)[:300]})
                        overlaps = audit.get("overlaps") or []
                        if overlaps:
                            summary["overlaps"] += len(overlaps)
                            for item in overlaps[:5]:
                                issues.append({"page": page_name, "viewport": viewport_name, "type": "overlap", "detail": json.dumps(item, ensure_ascii=False)[:300]})
                        broken = audit.get("broken_images") or []
                        if broken:
                            summary["broken_images"] += len(broken)
                            for item in broken[:5]:
                                issues.append({"page": page_name, "viewport": viewport_name, "type": "broken_image", "detail": json.dumps(item, ensure_ascii=False)[:300]})

                        relevant_console = [x for x in console_errors if x and "favicon" not in x.lower()][:10]
                        relevant_page = page_errors[:10]
                        if relevant_console or relevant_page:
                            summary["console_errors"] += len(relevant_console) + len(relevant_page)
                            for text in relevant_console[:4]:
                                issues.append({"page": page_name, "viewport": viewport_name, "type": "console_error", "detail": text})
                            for text in relevant_page[:4]:
                                issues.append({"page": page_name, "viewport": viewport_name, "type": "page_error", "detail": text})
                    except Exception as exc:
                        summary["navigation_errors"] += 1
                        issues.append({"page": page_name, "viewport": viewport_name, "type": "navigation_error", "detail": str(exc)[:300]})
                        run_data["navigation_error"] = str(exc)[:500]
                    finally:
                        detailed_runs.append(run_data)
                        page.close()
                context.close()
        finally:
            browser.close()

    weights = {
        "navigation_errors": 18,
        "viewport_meta_failures": 8,
        "horizontal_overflow": 18,
        "essential_offscreen": 16,
        "clipped_text": 8,
        "overlaps": 12,
        "broken_images": 12,
        "console_errors": 8,
    }
    penalty = 0
    for key, weight in weights.items():
        count = int(summary[key])
        if count:
            penalty += min(weight, 3 + count * max(1, weight // 5))
    coverage_ratio = viewport_runs / expected_runs if expected_runs else 0
    if coverage_ratio < 1:
        penalty += round((1 - coverage_ratio) * 20)
    score = max(0, min(100, 100 - penalty))

    report = {
        "score": score,
        "pages_expected": len(urls),
        "viewport_runs": viewport_runs,
        "expected_runs": expected_runs,
        "github_run_url": GITHUB_RUN_URL,
        "summary": summary,
        "issues": issues[:120],
    }
    (ARTIFACT_ROOT / "report.json").write_text(
        json.dumps({**report, "runs": detailed_runs}, ensure_ascii=False, indent=2), encoding="utf-8"
    )
    callback("completed", f"Auditoria visual completada con puntuacion {score}%.", report)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        callback("error", f"Error del runner visual: {exc}")
        print(f"Fatal visual runner error: {exc}", file=sys.stderr)
        sys.exit(1)
