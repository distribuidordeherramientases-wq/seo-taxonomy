+if (!function_exists('seo_analista_architecture_demand')) {
+    function seo_analista_architecture_demand($days = 28) {
+        $out = array();
+        if (!function_exists('seo_analista_get_data') || !function_exists('seo_analista_top_opportunities')) return $out;
+        $data = seo_analista_get_data($days);
+        if (empty($data['ready'])) return $out;
+        $rows = seo_analista_top_opportunities((array) ($data['queries'] ?? array()), (array) ($data['previous_queries'] ?? array()), 120);
+        foreach ((array) $rows as $row) {
+            $catalog = (array) ($row['catalog'] ?? array());
+            $cid = absint($catalog['term_id'] ?? 0);
+            if (!$cid) continue;
+            if (!isset($out[$cid])) $out[$cid] = array('impressions'=>0.0,'max_score'=>0,'queries'=>array());
+            $out[$cid]['impressions'] += (float) ($row['impressions'] ?? 0);
+            $out[$cid]['max_score'] = max($out[$cid]['max_score'], (int) ($row['score'] ?? 0));
+            $q = trim((string) ($row['query_text'] ?? ''));
+            if ($q !== '' && count($out[$cid]['queries']) < 8) $out[$cid]['queries'][] = $q;
+        }
+        return $out;
+    }
+}
