+if (!function_exists('seo_analista_architecture_product_vocab')) {
+    function seo_analista_architecture_product_vocab() {
+        global $wpdb;
+        $objects = $wpdb->prefix . 'seo_object_vocabulary';
+        $vocab = $wpdb->prefix . 'seo_vocabulary';
+        $out = array();
+        if (!seo_analista_architecture_table_exists($objects) || !seo_analista_architecture_table_exists($vocab) || !taxonomy_exists('product_cat')) return $out;
+        $rows = (array) $wpdb->get_results(
+            "SELECT tt.term_id,v.semantic_group,v.slug,v.label,COUNT(DISTINCT p.ID) AS n
+             FROM {$wpdb->term_relationships} tr
+             INNER JOIN {$wpdb->term_taxonomy} tt ON tt.term_taxonomy_id=tr.term_taxonomy_id AND tt.taxonomy='product_cat'
+             INNER JOIN {$wpdb->posts} p ON p.ID=tr.object_id AND p.post_type='product' AND p.post_status='publish'
+             INNER JOIN {$objects} ov ON ov.object_type='product' AND ov.object_id=p.ID AND ov.status=1
+             INNER JOIN {$vocab} v ON v.id=ov.vocabulary_id AND v.active=1
+             WHERE v.semantic_group IN ('tipo','subtipo','aplicacion','rol','plataforma')
+             GROUP BY tt.term_id,v.semantic_group,v.slug,v.label
+             HAVING n>0
+             ORDER BY tt.term_id,n DESC",
+            ARRAY_A
+        );
+        foreach ($rows as $row) {
+            $cid = absint($row['term_id'] ?? 0);
+            if (!$cid) continue;
+            if (!isset($out[$cid])) $out[$cid] = array();
+            if (count($out[$cid]) >= 18) continue;
+            $out[$cid][] = array(
+                'group'=>(string) ($row['semantic_group'] ?? ''),
+                'slug'=>(string) ($row['slug'] ?? ''),
+                'label'=>(string) ($row['label'] ?? ''),
+                'weight'=>min(8, max(1, (int) ($row['n'] ?? 1))),
+            );
+        }
+        return $out;
+    }
+}
