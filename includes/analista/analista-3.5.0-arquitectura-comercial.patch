+if (!function_exists('seo_analista_architecture_category_vocab')) {
+    function seo_analista_architecture_category_vocab() {
+        global $wpdb;
+        $objects = $wpdb->prefix . 'seo_object_vocabulary';
+        $vocab = $wpdb->prefix . 'seo_vocabulary';
+        $out = array();
+        if (!seo_analista_architecture_table_exists($objects) || !seo_analista_architecture_table_exists($vocab)) return $out;
+        $rows = (array) $wpdb->get_results(
+            "SELECT ov.object_id,v.semantic_group,v.slug,v.label
+             FROM {$objects} ov
+             INNER JOIN {$vocab} v ON v.id=ov.vocabulary_id
+             WHERE ov.object_type='product_cat' AND ov.status=1 AND v.active=1
+               AND v.semantic_group IN ('tipo','subtipo','aplicacion','rol','plataforma')",
+            ARRAY_A
+        );
+        foreach ($rows as $row) {
+            $cid = absint($row['object_id'] ?? 0);
+            if (!$cid) continue;
+            $out[$cid][] = array(
+                'group'=>(string) ($row['semantic_group'] ?? ''),
+                'slug'=>(string) ($row['slug'] ?? ''),
+                'label'=>(string) ($row['label'] ?? ''),
+                'weight'=>3,
+            );
