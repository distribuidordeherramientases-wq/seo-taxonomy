+if (!function_exists('seo_analista_architecture_gpc')) {
+    function seo_analista_architecture_gpc() {
+        global $wpdb;
+        $keys = apply_filters('seo_analista_architecture_gpc_meta_keys', array(
+            '_google_product_category', 'google_product_category', '_wc_google_product_category',
+            'gla_google_product_category', '_wc_gla_google_product_category'
+        ));
+        $keys = array_values(array_filter(array_map('sanitize_key', (array) $keys)));
+        $out = array('categories'=>array(),'products'=>0,'rows'=>0);
+        if (!$keys || !taxonomy_exists('product_cat')) return $out;
+        $placeholders = implode(',', array_fill(0, count($keys), '%s'));
+        $exists_sql = $wpdb->prepare("SELECT COUNT(*) FROM {$wpdb->postmeta} WHERE meta_key IN ({$placeholders}) AND meta_value<>''", $keys);
+        if (!(int) $wpdb->get_var($exists_sql)) return $out;
+        $sql = $wpdb->prepare(
+            "SELECT tt.term_id,pm.meta_value,COUNT(DISTINCT p.ID) AS n
+             FROM {$wpdb->posts} p
+             INNER JOIN {$wpdb->postmeta} pm ON pm.post_id=p.ID AND pm.meta_key IN ({$placeholders}) AND pm.meta_value<>''
+             INNER JOIN {$wpdb->term_relationships} tr ON tr.object_id=p.ID
+             INNER JOIN {$wpdb->term_taxonomy} tt ON tt.term_taxonomy_id=tr.term_taxonomy_id AND tt.taxonomy='product_cat'
+             WHERE p.post_type='product' AND p.post_status='publish'
+             GROUP BY tt.term_id,pm.meta_value
+             ORDER BY n DESC LIMIT 4000",
+            $keys
+        );
+        $rows = (array) $wpdb->get_results($sql, ARRAY_A);
+        $product_sum = 0;
+        foreach ($rows as $row) {
+            $cid = absint($row['term_id'] ?? 0);
+            $value = trim((string) ($row['meta_value'] ?? ''));
+            if (!$cid || $value === '') continue;
+            if (!isset($out['categories'][$cid])) $out['categories'][$cid] = array();
+            if (count($out['categories'][$cid]) >= 8) continue;
+            $n = max(1, (int) ($row['n'] ?? 1));
+            $out['categories'][$cid][] = array('value'=>$value,'products'=>$n);
+            $product_sum += $n;
+        }
+        $out['products'] = $product_sum;
+        $out['rows'] = count($rows);
+        return $out;
+    }
+}
