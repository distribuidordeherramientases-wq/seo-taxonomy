+if (!function_exists('seo_analista_architecture_hierarchy')) {
+    function seo_analista_architecture_hierarchy() {
+        global $wpdb;
+        $relations = $wpdb->prefix . 'seo_relations';
+        $out = array(
+            'cluster_to_primary'=>array(), 'primary_to_cluster'=>array(),
+            'primary_to_secondary'=>array(), 'secondary_to_primary'=>array(),
+            'secondary_to_category'=>array(), 'category_to_secondary'=>array(),
+        );
+        if (!seo_analista_architecture_table_exists($relations)) return $out;
+        $rows = (array) $wpdb->get_results(
+            "SELECT source_type,source_id,target_type,target_id,relation_type
+             FROM {$relations}
+             WHERE relation_type IN ('cluster_to_primary','hub_primary_to_hub_secondary','hub_secondary_to_category')
+               AND source_id>0 AND target_id>0",
+            ARRAY_A
+        );
+        foreach ($rows as $row) {
+            $sid = absint($row['source_id'] ?? 0);
+            $tid = absint($row['target_id'] ?? 0);
+            $type = (string) ($row['relation_type'] ?? '');
+            if (!$sid || !$tid) continue;
+            if ($type === 'cluster_to_primary') {
+                $out['cluster_to_primary'][$sid][$tid] = true;
+                $out['primary_to_cluster'][$tid][$sid] = true;
+            } elseif ($type === 'hub_primary_to_hub_secondary') {
+                $out['primary_to_secondary'][$sid][$tid] = true;
+                $out['secondary_to_primary'][$tid][$sid] = true;
+            } elseif ($type === 'hub_secondary_to_category') {
+                $out['secondary_to_category'][$sid][$tid] = true;
+                $out['category_to_secondary'][$tid][$sid] = true;
+            }
+        }
+        foreach ($out as &$map) {
+            foreach ($map as &$ids) $ids = array_values(array_map('absint', array_keys($ids)));
+            unset($ids);
+        }
+        unset($map);
+        return $out;
+    }
+}
