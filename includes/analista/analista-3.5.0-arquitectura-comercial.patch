+if (!function_exists('seo_analista_architecture_priority')) {
+    function seo_analista_architecture_priority($base, $products, $categories, $impressions = 0, $confidence = 0) {
+        $score = (float) $base;
+        $score += min(14, log(1 + max(0, (int) $products)) * 2.7);
+        $score += min(10, max(0, (int) $categories) * 1.4);
+        $score += min(8, log(1 + max(0, (float) $impressions)) * 1.6);
+        $score += min(6, max(0, (float) $confidence - 60) * 0.12);
+        return max(0, min(100, (int) round($score)));
+    }
+}
+
+if (!function_exists('seo_analista_architecture_row')) {
+    function seo_analista_architecture_row($action, $label, $topic, $reason, $priority, $confidence, array $changes, array $entity = array(), array $catalog = array(), array $evidence = array()) {
+        return array(
+            'priority'=>absint($priority),
+            'confidence'=>absint($confidence),
+            'action'=>(string) $action,
+            'action_label'=>(string) $label,
+            'channel'=>'arquitectura',
+            'topic'=>(string) $topic,
+            'reason'=>(string) $reason,
+            'source'=>'Catalogo + Vocabulary + Search Console + referencia Google cuando existe',
+            'sources'=>array('Catalogo','Vocabulary','Search Console','Google Product Category (si existe)'),
+            'recommended_changes'=>array_values(array_filter($changes)),
+            'evidence'=>array_values(array_filter($evidence)),
+            'entity'=>$entity,
+            'catalog'=>$catalog,
+            'metrics'=>array('impressions'=>(float) ($catalog['impressions'] ?? 0)),
+        );
+    }
+}
+
+if (!function_exists('seo_analista_architecture_advice')) {
+    function seo_analista_architecture_advice($days = 28, $limit = 80) {
+        $days = function_exists('seo_analista_days') ? seo_analista_days($days) : max(7, min(180, absint($days)));
+        $cache_key = 'seo_analista_arch35_' . get_current_blog_id() . '_' . $days . '_' . seo_analista_architecture_signature();
+        $cached = get_transient($cache_key);
+        if (is_array($cached)) return $cached;
+
+        $hier = seo_analista_architecture_hierarchy();
+        $profile_pack = seo_analista_architecture_category_profiles($days);
+        $categories = (array) ($profile_pack['categories'] ?? array());
+        $gpc_summary = (array) ($profile_pack['gpc_summary'] ?? array());
+        $recommendations = array();
+
+        $secondary_titles = array();
+        foreach (array_keys((array) $hier['secondary_to_category']) as $sid) $secondary_titles[$sid] = seo_analista_architecture_node_title($sid);
+        $primary_titles = array();
+        foreach (array_keys((array) $hier['primary_to_secondary']) as $pid) $primary_titles[$pid] = seo_analista_architecture_node_title($pid);
+        $cluster_titles = array();
+        foreach (array_keys((array) $hier['cluster_to_primary']) as $cid) $cluster_titles[$cid] = seo_analista_architecture_node_title($cid);
+
+        // 1) Categorias que encajan mucho mejor en un Hub secundario ya existente.
+        $secondary_family = array();
+        foreach ($hier['secondary_to_category'] as $sid => $cids) {
+            $stats = seo_analista_architecture_group_stats((array) $cids, $categories, 'family');
+            uasort($stats, static function($a,$b){ return (int) $b['products'] <=> (int) $a['products']; });
+            $secondary_family[$sid] = $stats ? (string) (reset($stats)['key'] ?? '') : '';
+        }
+        foreach ($categories as $cid => $cat) {
+            $family_key = (string) ($cat['family']['key'] ?? '');
+            if ($family_key === '' || empty($hier['category_to_secondary'][$cid])) continue;
+            $current_sid = absint($hier['category_to_secondary'][$cid][0] ?? 0);
+            if (!$current_sid || ($secondary_family[$current_sid] ?? '') === $family_key) continue;
+            $best_sid = 0;
+            $best_similarity = 0.0;
+            foreach ($secondary_family as $sid => $candidate_family) {
+                if ((int) $sid === $current_sid || $candidate_family !== $family_key) continue;
+                $sim = seo_analista_architecture_similarity((string) ($cat['family']['label'] ?? ''), (string) ($secondary_titles[$sid] ?? ''));
+                if ($sim > $best_similarity) { $best_similarity = $sim; $best_sid = absint($sid); }
+            }
+            if (!$best_sid || $best_similarity < 0.12) continue;
+            $products = (int) ($cat['products'] ?? 0);
+            $impressions = (float) ($cat['demand']['impressions'] ?? 0);
+            $confidence = min(94, 68 + ($best_similarity * 35) + (!empty($cat['gpc']) ? 7 : 0));
+            $recommendations[] = seo_analista_architecture_row(
+                'MOVER_CATEGORIA_HUB', 'Mover categoria de Hub', (string) $cat['title'],
+                'La familia semantica de esta categoria encaja mejor en un Hub secundario existente que en su Hub actual.',
+                seo_analista_architecture_priority(50, $products, 1, $impressions, $confidence), $confidence,
+                array(
+                    'Revisar salida de ' . ($secondary_titles[$current_sid] ?? ('Hub #' . $current_sid)) . '.',
+                    'Candidata a entrar en ' . ($secondary_titles[$best_sid] ?? ('Hub #' . $best_sid)) . '.',
+                    'Validar URL, enlazado y breadcrumb antes de cambiar la relacion estructural.'
+                ),
+                array('type'=>'category','type_label'=>'Categoria','id'=>$cid,'edit_url'=>admin_url('term.php?taxonomy=product_cat&tag_ID=' . $cid . '&post_type=product')),
+                array('category'=>(string) $cat['title'],'products'=>$products,'impressions'=>$impressions),
+                array((string) ($cat['family']['label'] ?? ''), 'Hub actual: ' . ($secondary_titles[$current_sid] ?? ''), 'Hub candidato: ' . ($secondary_titles[$best_sid] ?? ''))
+            );
+        }
+
+        // 2) Hubs secundarios nuevos cuando un Hub mezcla familias comerciales distintas.
+        foreach ($hier['secondary_to_category'] as $sid => $cids) {
+            $groups = seo_analista_architecture_group_stats((array) $cids, $categories, 'family');
+            $strong = array();
+            $total_products = 0;
+            foreach ((array) $cids as $cid) $total_products += (int) ($categories[$cid]['products'] ?? 0);
+            foreach ($groups as $group) {
+                if (count($group['categories']) >= 2 && $group['products'] >= 10) $strong[] = $group;
+            }
+            if (count($strong) < 2 && count($groups) < 3) continue;
+            foreach ($strong as $group) {
+                $current_title = (string) ($secondary_titles[$sid] ?? ('Hub #' . $sid));
+                if (seo_analista_architecture_similarity($group['label'], $current_title) >= 0.34) continue;
+                $existing_family_hub = 0;
+                foreach ($secondary_family as $candidate_sid => $candidate_family) {
+                    if ((int) $candidate_sid !== (int) $sid && (string) $candidate_family === (string) $group['key']) {
+                        $existing_family_hub = absint($candidate_sid);
+                        break;
+                    }
+                }
+                // Si ya existe un Hub especializado para esta familia, la accion correcta
+                // es redistribuir categorias, no crear otro Hub duplicado.
+                if ($existing_family_hub) continue;
+                $ratio = $total_products > 0 ? $group['products'] / $total_products : 0;
+                if ($ratio < 0.12 && $group['impressions'] < 20) continue;
+                $confidence = min(96, 60 + count($group['categories']) * 5 + min(16, $group['products'] / 5) + ($group['gpc_categories'] ? 5 : 0));
+                $names = array();
+                foreach ($group['categories'] as $cid) if (!empty($categories[$cid]['title'])) $names[] = $categories[$cid]['title'];
+                $recommendations[] = seo_analista_architecture_row(
+                    'CREAR_HUB_SECUNDARIO', 'Crear Hub secundario', $group['label'],
+                    'Hay una familia coherente dentro de un Hub secundario que mezcla intenciones distintas. Separarla mejora navegacion, rastreo y lectura semantica.',
+                    seo_analista_architecture_priority(52, $group['products'], count($group['categories']), $group['impressions'], $confidence), $confidence,
+                    array(
+                        'Crear Hub secundario "' . $group['label'] . '".',
+                        'Mover inicialmente estas categorias: ' . implode(', ', array_slice($names, 0, 10)) . '.',
+                        'Mantener atributos transversales como medidas, marcas, materiales o voltajes fuera de la jerarquia salvo que tengan intencion propia.'
+                    ),
+                    array('type'=>'hub_secondary','type_label'=>'Hub secundario actual','id'=>absint($sid),'url'=>get_permalink(absint($sid))),
+                    array('category'=>$current_title,'products'=>$group['products'],'impressions'=>$group['impressions']),
+                    array('Familia: ' . $group['label'], count($group['categories']) . ' categorias', $group['products'] . ' productos', $group['gpc_categories'] . ' categorias con referencia GPC')
+                );
+            }
+        }
+
+        // 3) Hubs primarios nuevos: una macrofamilia con varias familias secundarias reales.
+        foreach ($hier['primary_to_secondary'] as $pid => $sids) {
+            $all_cids = array();
+            foreach ((array) $sids as $sid) $all_cids = array_merge($all_cids, (array) ($hier['secondary_to_category'][$sid] ?? array()));
+            $all_cids = array_values(array_unique(array_map('absint', $all_cids)));
+            $macros = seo_analista_architecture_group_stats($all_cids, $categories, 'macro');
+            foreach ($macros as $macro) {
+                if (count($macro['categories']) < 5 || $macro['products'] < 50 || count($macro['families']) < 2) continue;
+                $current_title = (string) ($primary_titles[$pid] ?? ('Hub primary #' . $pid));
+                if (seo_analista_architecture_similarity($macro['label'], $current_title) >= 0.34) continue;
+                $confidence = min(96, 63 + count($macro['families']) * 6 + min(15, count($macro['categories'])) + ($macro['gpc_categories'] ? 5 : 0));
+                $family_labels = array();
+                $defs = seo_analista_architecture_reference_families();
+                foreach ($macro['families'] as $family_key) $family_labels[] = (string) ($defs[$family_key]['label'] ?? $family_key);
+                $recommendations[] = seo_analista_architecture_row(
+                    'CREAR_HUB_PRIMARIO', 'Crear Hub primario', $macro['label'],
+                    'La rama ya contiene varias familias secundarias coherentes con suficiente profundidad para tratarlas como un dominio comercial propio.',
+                    seo_analista_architecture_priority(55, $macro['products'], count($macro['categories']), $macro['impressions'], $confidence), $confidence,
+                    array(
+                        'Crear Hub primario "' . $macro['label'] . '" si la rama padre se mantiene como Cluster o se promueve a Cluster.',
+                        'Organizar debajo Hubs secundarios como: ' . implode(', ', array_slice($family_labels, 0, 8)) . '.',
+                        'No crear el Hub primario solo por volumen: confirmar que cada familia tiene inventario, URLs estables y sentido de compra.'
+                    ),
+                    array('type'=>'hub_primary','type_label'=>'Hub primario actual','id'=>absint($pid),'url'=>get_permalink(absint($pid))),
+                    array('category'=>$current_title,'products'=>$macro['products'],'impressions'=>$macro['impressions']),
+                    array(count($macro['families']) . ' familias', count($macro['categories']) . ' categorias', $macro['products'] . ' productos')
+                );
+            }
+
+            // 4) Si un Hub primario ya contiene varios dominios grandes, esta actuando como un Cluster.
+            $strong_macros = array_values(array_filter($macros, static function($m){
+                return count((array) ($m['categories'] ?? array())) >= 4 && (int) ($m['products'] ?? 0) >= 35;
+            }));
+            $primary_products = 0;
+            foreach ($all_cids as $cid) $primary_products += (int) ($categories[$cid]['products'] ?? 0);
+            if (count($strong_macros) >= 2 && count((array) $sids) >= 3 && $primary_products >= 180) {
+                usort($strong_macros, static function($a,$b){ return (int) $b['products'] <=> (int) $a['products']; });
+                $largest_ratio = $primary_products > 0 ? ((int) ($strong_macros[0]['products'] ?? 0) / $primary_products) : 1;
+                $cluster_ids = (array) ($hier['primary_to_cluster'][$pid] ?? array());
+                $cluster_id = absint($cluster_ids[0] ?? 0);
+                $cluster_title = $cluster_id ? (string) ($cluster_titles[$cluster_id] ?? '') : '';
+                $current_title = (string) ($primary_titles[$pid] ?? ('Hub primary #' . $pid));
+                $confidence = min(94, 65 + count($strong_macros) * 5 + min(10, count((array) $sids)) + ($largest_ratio < 0.70 ? 8 : 0));
+                $proposed = array();
+                foreach ($strong_macros as $macro) $proposed[] = (string) $macro['label'];
+                $action = ($primary_products >= 300 && count($strong_macros) >= 3 && $largest_ratio < 0.72) ? 'CREAR_CLUSTER' : 'EVALUAR_NUEVO_CLUSTER';
+                $label = $action === 'CREAR_CLUSTER' ? 'Crear Cluster' : 'Evaluar nuevo Cluster';
+                $recommendations[] = seo_analista_architecture_row(
+                    $action, $label, $current_title,
+                    'Este Hub primario contiene varios dominios comerciales grandes. Puede estar desempenando el papel de un Cluster y merece comparar dos escenarios antes de seguir creciendo.',
+                    seo_analista_architecture_priority($action === 'CREAR_CLUSTER' ? 58 : 50, $primary_products, count($all_cids), 0, $confidence), $confidence,
+                    array(
+                        'Escenario A: mantener el Cluster actual' . ($cluster_title !== '' ? ' (' . $cluster_title . ')' : '') . ' y crear Hubs primarios especializados.',
+                        'Escenario B: promover "' . $current_title . '" a Cluster y crear debajo Hubs primarios como ' . implode(', ', array_slice($proposed, 0, 6)) . '.',
+                        'Elegir el escenario con mayor coherencia semantica, demanda y estabilidad de URLs; no mover por volumen solamente.'
+                    ),
+                    array('type'=>'hub_primary','type_label'=>'Hub primario','id'=>absint($pid),'url'=>get_permalink(absint($pid))),
+                    array('category'=>$current_title,'products'=>$primary_products,'impressions'=>0),
+                    array(count($strong_macros) . ' dominios fuertes', count($all_cids) . ' categorias', $primary_products . ' productos', 'Cluster actual: ' . ($cluster_title ?: 'sin resolver'))
+                );
+            }
+        }
+
+        usort($recommendations, static function($a,$b){
+            $diff = (int) ($b['priority'] ?? 0) <=> (int) ($a['priority'] ?? 0);
+            if ($diff) return $diff;
+            return (int) ($b['confidence'] ?? 0) <=> (int) ($a['confidence'] ?? 0);
+        });
+        $recommendations = array_slice($recommendations, 0, max(10, min(150, absint($limit))));
+
+        $summary = array(
+            'recommendations'=>count($recommendations),
+            'move_category'=>0,
+            'create_secondary'=>0,
+            'create_primary'=>0,
+            'cluster_review'=>0,
+            'gpc_rows'=>(int) ($gpc_summary['rows'] ?? 0),
+            'gpc_products'=>(int) ($gpc_summary['products'] ?? 0),
+        );
+        foreach ($recommendations as $row) {
+            $action = (string) ($row['action'] ?? '');
+            if ($action === 'MOVER_CATEGORIA_HUB') $summary['move_category']++;
+            elseif ($action === 'CREAR_HUB_SECUNDARIO') $summary['create_secondary']++;
+            elseif ($action === 'CREAR_HUB_PRIMARIO') $summary['create_primary']++;
+            elseif (in_array($action, array('CREAR_CLUSTER','EVALUAR_NUEVO_CLUSTER'), true)) $summary['cluster_review']++;
+        }
+
+        $result = array(
+            'available'=>(bool) $categories,
+            'read_only'=>true,
+            'reference_model'=>array(
+                'site_model'=>'Cluster > Hub Primary > Hub Secondary > Categoria > Producto',
+                'google_role'=>'Google Product Category se usa solo como referencia externa cuando existe en el dato de producto; no define la jerarquia del sitio.',
+                'decision_rule'=>'Catalogo + Vocabulary + demanda + coherencia estructural; GPC puede confirmar, nunca imponer.',
+            ),
+            'summary'=>$summary,
+            'recommendations'=>$recommendations,
+        );
+        set_transient($cache_key, $result, 20 * MINUTE_IN_SECONDS);
+        return $result;
+    }
+}
+
+if (!function_exists('seo_analista_architecture_work')) {
+    function seo_analista_architecture_work($days = 28, $limit = 60) {
+        $advice = seo_analista_architecture_advice($days, $limit);
+        return array_slice((array) ($advice['recommendations'] ?? array()), 0, max(5, min(100, absint($limit))));
+    }
+}
