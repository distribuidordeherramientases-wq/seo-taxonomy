+if (!function_exists('seo_analista_architecture_category_profiles')) {
+    function seo_analista_architecture_category_profiles($days = 28) {
+        $terms = taxonomy_exists('product_cat') ? get_terms(array('taxonomy'=>'product_cat','hide_empty'=>false)) : array();
+        if (is_wp_error($terms)) $terms = array();
+        $direct = seo_analista_architecture_category_vocab();
+        $product_vocab = seo_analista_architecture_product_vocab();
+        $gpc = seo_analista_architecture_gpc();
+        $demand = seo_analista_architecture_demand($days);
+        $out = array();
+        foreach ((array) $terms as $term) {
+            $cid = absint($term->term_id ?? 0);
+            if (!$cid) continue;
+            $vocab = array_merge((array) ($direct[$cid] ?? array()), (array) ($product_vocab[$cid] ?? array()));
+            $chunks = array((string) $term->name, (string) $term->slug);
+            foreach ($vocab as $v) {
+                $chunks[] = (string) ($v['label'] ?? '');
+                $chunks[] = (string) ($v['slug'] ?? '');
+            }
+            foreach ((array) ($gpc['categories'][$cid] ?? array()) as $row) $chunks[] = (string) ($row['value'] ?? '');
+            $semantic_text = implode(' ', array_filter($chunks));
+            $family = seo_analista_architecture_family($semantic_text);
+            $out[$cid] = array(
+                'id'=>$cid,
+                'title'=>(string) $term->name,
+                'slug'=>(string) $term->slug,
+                'products'=>(int) $term->count,
+                'semantic_text'=>$semantic_text,
+                'family'=>$family,
+                'vocabulary'=>$vocab,
+                'gpc'=>(array) ($gpc['categories'][$cid] ?? array()),
+                'demand'=>(array) ($demand[$cid] ?? array('impressions'=>0,'max_score'=>0,'queries'=>array())),
+            );
+        }
+        return array('categories'=>$out,'gpc_summary'=>array('rows'=>(int) ($gpc['rows'] ?? 0),'products'=>(int) ($gpc['products'] ?? 0)));
+    }
+}
