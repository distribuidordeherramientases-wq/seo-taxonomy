+if (!function_exists('seo_analista_architecture_family')) {
+    function seo_analista_architecture_family($text) {
+        $text = seo_analista_architecture_norm($text);
+        if ($text === '') return array('key'=>'','label'=>'','macro'=>'','score'=>0);
+        $best = array('key'=>'','label'=>'','macro'=>'','score'=>0);
+        foreach (seo_analista_architecture_reference_families() as $key => $family) {
+            $score = 0;
+            foreach ((array) ($family['keywords'] ?? array()) as $keyword) {
+                $needle = seo_analista_architecture_norm($keyword);
+                if ($needle !== '' && strpos($text, $needle) !== false) $score += (strpos($needle, ' ') !== false ? 3 : 2);
+            }
+            if ($score > $best['score']) {
+                $best = array(
+                    'key' => (string) $key,
+                    'label' => (string) ($family['label'] ?? $key),
+                    'macro' => (string) ($family['macro'] ?? ''),
+                    'score' => $score,
+                );
+            }
+        }
+        return $best['score'] > 0 ? $best : array('key'=>'','label'=>'','macro'=>'','score'=>0);
+    }
+}
