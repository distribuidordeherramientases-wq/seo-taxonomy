+if (!function_exists('seo_analista_architecture_group_stats')) {
+    function seo_analista_architecture_group_stats(array $category_ids, array $categories, $key = 'family') {
+        $groups = array();
+        foreach ($category_ids as $cid) {
+            $cid = absint($cid);
+            if (!$cid || empty($categories[$cid])) continue;
+            $cat = $categories[$cid];
+            $family = (array) ($cat['family'] ?? array());
+            $group_key = $key === 'macro' ? (string) ($family['macro'] ?? '') : (string) ($family['key'] ?? '');
+            if ($group_key === '') continue;
+            $label = $key === 'macro'
+                ? (string) ((seo_analista_architecture_macro_labels())[$group_key] ?? $group_key)
+                : (string) ($family['label'] ?? $group_key);
+            if (!isset($groups[$group_key])) {
+                $groups[$group_key] = array('key'=>$group_key,'label'=>$label,'categories'=>array(),'products'=>0,'impressions'=>0.0,'gpc_categories'=>0,'families'=>array());
+            }
+            $groups[$group_key]['categories'][] = $cid;
+            $groups[$group_key]['products'] += (int) ($cat['products'] ?? 0);
+            $groups[$group_key]['impressions'] += (float) ($cat['demand']['impressions'] ?? 0);
+            if (!empty($cat['gpc'])) $groups[$group_key]['gpc_categories']++;
+            if (!empty($family['key'])) $groups[$group_key]['families'][(string) $family['key']] = true;
+        }
+        foreach ($groups as &$group) {
+            $group['categories'] = array_values(array_unique(array_map('absint', $group['categories'])));
+            $group['families'] = array_values(array_keys($group['families']));
+        }
+        unset($group);
+        return $groups;
+    }
+}
