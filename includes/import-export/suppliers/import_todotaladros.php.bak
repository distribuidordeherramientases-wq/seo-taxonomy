<?php
/**
 * Receta oficial TodoTaladros para el importador de proveedores de SEO System.
 *
 * Filosofia SATKIT:
 * - La receta solo declara el proveedor y activa el mapeo visual.
 * - No rastrea la web.
 * - No descarga fichas ni imagenes.
 * - No programa cron ni usa crawler-queue.php.
 * - El usuario revisa la relacion entre las columnas del archivo y la
 *   plantilla comun; despues el motor general crea y conserva el CSV estandar.
 *
 * El archivo de entrada debe contener los datos de producto obtenidos por el
 * proceso externo que corresponda (CSV/XLS/XLSX). Si las imagenes llegan como
 * URLs, se deben mapear al campo comun "imagenes"; posteriormente el catalogo
 * de proveedores puede mantenerlas como imagenes externas sin descargarlas a
 * Media.
 *
 * @package SEOSystem
 * @subpackage SupplierImports
 * @version 1.1.0
 */

defined( 'ABSPATH' ) || exit;

/* Esta receta solo mapea columnas. No escribe productos ni programa la cola. */
add_filter(
    'seo_proveedores_import_recipes',
    static function ( $recipes ) {
        if ( ! is_array( $recipes ) ) {
            $recipes = [];
        }

        $recipes['todotaladros'] = [
            'id'          => 'todotaladros',
            'label'       => 'TodoTaladros - mapeo de archivo',
            'provider'    => 'TODOTALADROS',
            'version'     => '1.1.0',
            'mode'        => 'mapping',
            'description' => 'Importa un CSV/XLS/XLSX de TodoTaladros mediante el mapeo visual comun. La receta no rastrea la web ni descarga imagenes.',
        ];

        return $recipes;
    }
);


/**
 * Fuente web externa de TodoTaladros.
 *
 * La receta de importacion anterior se conserva para cargas manuales. Esta
 * entrada adicional hace que TodoTaladros aparezca en "Obtener catalogo desde
 * la web" y delega el scraping Python en GitHub Actions. El CSV que vuelve se
 * asocia a la receta de importacion "todotaladros" y entra por el mismo motor
 * comun / Supplier Sync V2.
 */
add_filter(
    'seo_supplier_external_web_recipes',
    static function ( $recipes ) {
        if ( ! is_array( $recipes ) ) {
            $recipes = [];
        }

        $recipes['todotaladros_github'] = [
            'id'               => 'todotaladros_github',
            'label'            => 'TodoTaladros - Python externo',
            'provider'         => 'TODOTALADROS',
            'version'          => '1.0.0',
            'runner'           => 'github',
            'import_recipe_id' => 'todotaladros',
            'description'      => 'Ejecuta el scraper Python de TodoTaladros en GitHub Actions y devuelve automaticamente el CSV estandar a WordPress.',
        ];

        return $recipes;
    }
);
