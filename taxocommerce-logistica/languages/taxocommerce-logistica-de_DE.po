msgid "Technical Manual"
msgstr "Technisches Handbuch"

#: includes/class-user-guide.php:326
msgid "Índice del manual"
msgstr "Inhaltsverzeichnis des Handbuchs"

#: includes/class-user-guide.php:327
msgid "Contenido"
msgstr "Inhalt"

