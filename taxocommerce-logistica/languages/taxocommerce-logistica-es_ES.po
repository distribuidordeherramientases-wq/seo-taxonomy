#: includes/class-auto-test.php:526
msgid "Sin permisos para Auto Test."
msgstr "Sin permisos para Auto Test."

#: includes/class-auto-test.php:547
msgid "Sin permisos para descargar Auto Test."
msgstr "Sin permisos para descargar Auto Test."

#: includes/class-auto-test.php:554
