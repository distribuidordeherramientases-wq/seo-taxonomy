msgstr "Cluster"

msgid "Cluster → Hub primario"
msgstr "Cluster → Primary hub"

msgid "Cluster → Hub primario → Hub secundario → Categoría → Producto"
msgstr "Cluster → Primary hub → Secondary hub → Category → Product"

msgid "Cluster → Hub primario → Hub secundario → Categoría de producto. La jerarquía sigue siendo la fuente de la propuesta; WordPress conserva el menú publicado."
msgstr "Cluster → Primary hub → Secondary hub → Product category. The hierarchy remains the source of the proposed menu; WordPress retains the published menu."

msgid "Cluster → Hub primario → Hub secundario → Categoría. Cada nivel muestra elementos únicos; no representa un embudo de conversión."
msgstr "Cluster → Primary hub → Secondary hub → Category. Each level shows unique items and does not represent a conversion funnel."

msgid "Cluster, Hub primario, Hub secundario, Categoría, Producto"
msgstr "Cluster, Primary hub, Secondary hub, Category, Product"

msgid "Clusters"
msgstr "Clusters"

msgid "Clusters ordenados por número de productos, con recuentos únicos en cada nivel."
msgstr "Clusters ordered by product count, with unique counts at each level."

msgid "Cobertura de productos únicos dentro de cada cluster; un producto en varios clusters puede figurar en más de una barra."
msgstr "Unique product coverage by cluster; a product linked to multiple clusters may appear in multiple bars."

