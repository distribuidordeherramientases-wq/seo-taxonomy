msgstr "Core documentation: user and technical guides in one section."

msgid "Edita productos, categorías de WooCommerce, entradas y páginas desde un entorno unificado."
msgstr "Edit WooCommerce products and categories, posts and pages from one interface."

msgid "Editar aquí"
msgstr "Edit here"

msgid "Editar manualmente en WordPress"
msgstr "Edit manually in WordPress"

msgid "Editar página"
msgstr "Edit page"

msgid "Editor nativo"
msgstr "Native editor"

msgid "EDITOR VISUAL"
msgstr "VISUAL EDITOR"

