#: includes/class-taxocommerce-faqs.php:558
#: includes/class-taxocommerce-faqs.php:608
msgid "FAQs"
msgstr "FAQ"

#: includes/class-taxocommerce-faqs.php:128
msgid "No tienes permisos para gestionar FAQs."
msgstr "Vous n'avez pas l'autorisation de gérer les FAQ."

#: includes/class-taxocommerce-faqs.php:557
msgid "Secciones de FAQs"
msgstr "Rubriques FAQ"

#: includes/class-taxocommerce-faqs.php:558
msgid "Auto Test"
msgstr "Auto Test"

#: includes/class-taxocommerce-faqs.php:558
msgid "Manual"
msgstr "Manuel"

#: includes/class-taxocommerce-faqs.php:573
msgid ""
"Falta la tabla de FAQs; desactiva y reactiva TaxoCommerce FAQs para "
"instalarla."
msgstr "La table FAQ est absente ; désactivez puis réactivez TaxoCommerce FAQs pour l'installer."

#: includes/class-taxocommerce-faqs.php:608
msgid ""
"Preguntas frecuentes asociadas a hubs, categorías o productos. Datos "
"compartidos con TaxoCommerce SEO."
msgstr "Questions fréquentes associées aux hubs, catégories ou produits. Données partagées avec TaxoCommerce SEO."

#: includes/class-taxocommerce-faqs.php:617
msgid "Categoría de producto *"
msgstr "Catégorie de produit *"

#: includes/class-taxocommerce-faqs.php:621
msgid ""
"Obligatoria. Las FAQs anteriores sin categoría aparecen en el KPI "
"correspondiente."
msgstr "Obligatoire. Les anciennes FAQ sans catégorie figurent dans l'indicateur correspondant."

#: includes/class-taxocommerce-faqs.php:621
#: includes/class-taxocommerce-faqs.php:653
msgid "Destino"
msgstr "Destination"

#: includes/class-taxocommerce-faqs.php:631
msgid "Etiquetas de Vocabulary"
msgstr "Étiquettes Vocabulary"

#: includes/class-taxocommerce-faqs.php:631
msgid "Selecciona las etiquetas existentes. No se crean etiquetas nuevas."
msgstr "Sélectionnez les étiquettes existantes. Aucune nouvelle étiquette n'est créée."

#: includes/class-taxocommerce-faqs.php:644
msgid ""
"Vocabulary no está disponible; se conservarán las etiquetas existentes."
msgstr "Vocabulary est indisponible ; les étiquettes existantes seront conservées."

#: includes/class-taxocommerce-faqs.php:652
msgid "Buscar"
msgstr "Rechercher"

#: includes/class-taxocommerce-faqs.php:653
msgid "Pregunta"
msgstr "Question"

#: includes/class-taxocommerce-faqs.php:653
msgid "Categoría"
msgstr "Catégorie"

#: includes/class-taxocommerce-faqs.php:653
msgid "Activa"
msgstr "Active"

#: includes/class-taxocommerce-faqs.php:653
msgid "Aperturas"
msgstr "Ouvertures"

#: includes/class-taxocommerce-faqs.php:653
msgid "Acciones"
msgstr "Actions"

#: includes/class-taxocommerce-faqs.php:659
msgid "Eliminar"
msgstr "Supprimer"

#: includes/class-taxocommerce-faqs.php:665
msgid "Importar / Exportar CSV"
msgstr "Importer / Exporter CSV"

#: includes/class-taxocommerce-faqs.php:665
msgid ""
"CSV UTF-8; hasta 500 filas y 2 MB por importación. Solo se actualiza un ID "
"existente; las nuevas filas reciben ID nuevo."
