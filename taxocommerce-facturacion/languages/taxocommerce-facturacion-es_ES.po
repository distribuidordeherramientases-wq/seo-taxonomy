msgid "15. Diagnósticos habituales"
msgstr "15. Diagnósticos habituales"

#: includes/class-taxocommerce-billing-manual.php:77
msgid "No aparecen facturas:"
msgstr "No aparecen facturas:"

#: includes/class-taxocommerce-billing-manual.php:77
msgid ""
"revisa que WooCommerce esté activo, el sistema documental habilitado, la "
"emisión automática seleccionada y el estado del pedido."
msgstr "revisa que WooCommerce esté activo, el sistema documental habilitado, la emisión automática seleccionada y el estado del pedido."

#: includes/class-taxocommerce-billing-manual.php:78
msgid "No se genera PDF:"
msgstr "No se genera PDF:"

#: includes/class-taxocommerce-billing-manual.php:78
msgid ""
"revisa Dompdf y permisos de los archivos privados; consulta el último error "
"del documento."
msgstr "revisa Dompdf y permisos de los archivos privados; consulta el último error del documento."

#: includes/class-taxocommerce-billing-manual.php:79
msgid "Faltan documentos antiguos:"
msgstr "Faltan documentos antiguos:"

#: includes/class-taxocommerce-billing-manual.php:79
msgid ""
"comprueba que persiste la tabla legada y que no se ha alterado la numeración"
" o los datos de migración."
msgstr "comprueba que persiste la tabla legada y que no se ha alterado la numeración o los datos de migración."

#: includes/class-taxocommerce-billing-manual.php:80
msgid "El carrito no ofrece presupuestos:"
msgstr "El carrito no ofrece presupuestos:"

#: includes/class-taxocommerce-billing-manual.php:80
msgid ""
"revisa su activación, el tipo de carrito (clásico o bloque) y el shortcode "
"si procede."
msgstr "revisa su activación, el tipo de carrito (clásico o bloque) y el shortcode si procede."

#: includes/class-taxocommerce-billing-manual.php:81
msgid "El cliente no descarga un documento:"
msgstr "El cliente no descarga un documento:"

#: includes/class-taxocommerce-billing-manual.php:81
msgid ""
"revisa permisos del pedido y restricciones de descarga, nunca hagas públicos"
" los archivos."
msgstr "revisa permisos del pedido y restricciones de descarga, nunca hagas públicos los archivos."

#: includes/class-taxocommerce-billing-manual.php:82
msgid "Autotest indica aviso:"
msgstr "Autotest indica aviso:"

#: includes/class-taxocommerce-billing-manual.php:82
msgid ""
"distingue una opción no guardada de un error funcional. El test nunca emite "
"facturas de prueba."
msgstr "distingue una opción no guardada de un error funcional. El test nunca emite facturas de prueba."

