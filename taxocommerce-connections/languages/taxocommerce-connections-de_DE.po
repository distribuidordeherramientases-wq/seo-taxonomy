#. Plugin Name of the plugin
#: taxocommerce-connections.php
msgid "TaxoCommerce Connections (Compatibility Bridge)"
msgstr "TaxoCommerce Connections (Kompatibilitätsbrücke)"

#. Description of the plugin
#: taxocommerce-connections.php
msgid ""
"Temporary compatibility bridge. External connections now live inside "
"TaxoCommerce Insights."
msgstr "Temporäre Kompatibilitätsbrücke. Externe Verbindungen werden jetzt in TaxoCommerce Insights verwaltet."

#. Author of the plugin
#: taxocommerce-connections.php
msgid "David Perez"
msgstr "David Perez"

