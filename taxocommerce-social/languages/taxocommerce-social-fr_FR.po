#: includes/admin.php:74
msgid ""
"Publicación social autónoma. Conexiones, formatos y calendario sin campañas,"
" ofertas ni reglas especiales de Noticias."
msgstr "Publication sociale autonome. Connexions, formats et calendrier sans campagnes, offres ni règles particulières pour les actualités."

